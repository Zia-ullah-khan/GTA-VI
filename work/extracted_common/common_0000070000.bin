    <Item type="CDamageModifierForceBleedout">
      <Name>ForcePoisonBleedout</Name>
      <VerifyAllowed value="true"/>
      <BleedoutType>Poison</BleedoutType>
      <Condition type="CDamageConditionAnd">
        <Conditions>
          <Item type="CDamageConditionFromAmmoType">
            <AmmoTypes>
              <Item>AMMO_ARROW_POISON</Item>
              <Item>AMMO_THROWING_KNIVES_POISON</Item>
            </AmmoTypes>
          </Item>
          <Item type="CDamageConditionVictimExists"/>
