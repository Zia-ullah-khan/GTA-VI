<?xml version="1.0" encoding="UTF-8"?>
<PathingStyleData>
  <StyleProfiles>
    <Item key="Pathing_Natural">
      <CurvatureStyle>Curvature_Natural</CurvatureStyle>
      <CorneringStyle>Cornering_Natural</CorneringStyle>
      <ApproachStyle>Approach_Natural</ApproachStyle>
      <ContinuityStyle>Continuity_Natural</ContinuityStyle>
      <SlowdownStyle>Slowdown_Natural</SlowdownStyle> 
      <SplineConfig>SplineFollow_Natural</SplineConfig>
      <AvoidanceStyle>Avoidance_Natural</AvoidanceStyle>
	  <Flags></Flags>
    </Item>
    <Item key="Pathing_Wanderer">
      <CurvatureStyle>Curvature_Curved</CurvatureStyle>
