s:\n        if ct == \"badge\":\n            draw_speedrun_badge(ax, c5_x, cy, mw, 1.5 if \"FASTEST\" in t else 1.2, t, s, font_size=7.2)\n        elif ct == \"heart\":\n            draw_heart(ax, c5_x, cy, mw, 1.5, t + \"\\n\" + s, skip_label=\"[SLOW FOR ANY%]\")\n        else:\n            draw_mission(ax, c5_x, cy, mw, 1.15, t, s, is_climax=(ct==\"climax\"))\n            \n    out_path = os.path.join(WORKSPACE_DIR, \"GTAVI_SPEEDRUN_CAMPAIGN_MASTER.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\nif __name__ == \"__main__\":\n    print(\"Generating GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png...\")\n    render_speedrun_chapter_1()\n    print(\"Generating GTAVI_SPEEDRUN_CAMPAIGN_MASTER.png...\")\n    render_speedrun_master_campaign()\n    \n    for fn in [\"GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png\", \"GTAVI_SPEEDRUN_CAMPAIGN_MASTER.png\"]:\n        src = os.path.join(WORKSPACE_DIR, fn)\n        dst = os.path.join(ARTIFACT_DIR, fn)\n        if os.path.exists(src):\n            shutil.copyfile(src, dst)\n            print(f\"Copied {fn} to artifact directory.\")\n    print(\"SPEEDRUN FLOWCHARTS COMPLETE!\")\n","Description":"Python script to render both the GTAVI_MISSION_FLOW1.jpg-style complete Chapter 1 flowchart and the Campaign Master Speedrun Routing map","Overwrite":true,"TargetFile":"C:\\Users\\<user>\\.gemini\\antigravity-cli\\brain\\96252013-4633-45e8-b6a2-59b18be9e68c\\scratch\\build_speedrun_flowcharts.py","toolAction":"Writing speedrun flowchart builder script","toolSummary":"Create build_speedrun_flowcharts.py"}}]}
