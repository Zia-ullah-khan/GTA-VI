<?xml version="1.0" encoding="UTF-8"?>
<CDoorInteractionDataList>
  <!-- Defines the blackboard variables required for a given interaction pose to be selected in the Interaction_Upper upperbody search tree (used by EntityInteraction as well) -->
  <UpperbodyPoseRequiredBlackboardVariables>
    <Item key="WeaponPose_PointWeaponUp" type="InteractionUpperbodyHelpers::UpperbodyPoseType">
      <RequiredVariables>
        <Item>Interaction_WeaponPose_PointWeaponUp</Item>
      </RequiredVariables>
    </Item>
    <Item key="WeaponPose_PointWeaponDown" type="InteractionUpperbodyHelpers::UpperbodyPoseType">
      <RequiredVariables>
        <Item>Interaction_WeaponPose_PointWeaponDown</Item>
      </RequiredVariables>
    </Item>
    <Item key="WeaponPose_Default" type="InteractionUpperbodyHelpers::UpperbodyPoseType">
      <RequiredVariables>
        <Item>Interaction_WeaponPose_Default</Item>
      </RequiredVariables>
    </Item>
    <Item key="WeaponPose_UseOneHanded" type="InteractionUpperbodyHelpers::UpperbodyPoseType">
      <RequiredVariables>
        <Item>Interaction_WeaponPose_UseOneHanded</Item>
      </RequiredVariables>
    </Item>
  </UpperbodyPoseRequiredBlackboardVariables>

