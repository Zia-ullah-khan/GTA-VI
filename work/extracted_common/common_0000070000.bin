            <Condition type="CDamageConditionVictimIsPlayer"/>
          </Item>
          <Item type="CDamageConditionShouldAllowBleedout"/>
        </Conditions>
      </Condition>
      <NextModifierPolicy>OnConditionFailure</NextModifierPolicy>
    </Item>
    <Item type="CDamageModifierForceBleedout">
