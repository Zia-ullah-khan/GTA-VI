isplay_name\"], hours[\"hour_property_0x1FD5BB99\"],\r\n251:                          hours[\"hour_property_0xB376AD2B\"], source])\r\n252: \r\n253:     return table([\"ID\", \"Title\", \"0x1FD5BB99 (opens)\", \"0xB376AD2B (closes)\", \"Data file\"], rows)\r\n254: \r\n255: \r\n256: def autolaunch_table(entries: list[dict]) -> str:\r\n257:     rows = []\r\n258:     for entry in entries:\r\n259:         if not any(marker in entry[\"id\"] for marker in AUTOLAUNCH_MARKERS):\r\n260:             continue\r","truncated_fields":["content"]}
