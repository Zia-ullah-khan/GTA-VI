ripts_23_11_2026'\\nns = set()\\nfor fn in ['story000.ysc.cs', '0xD2601E252151E04B.ysc.cs', '0x947D998BD81F7AC1.ysc.cs', '0x224CF31C94E0534D.ysc.cs']:\\n    with open(os.path.join(base, fn), 'r', encoding='utf-8', errors='replace') as f:\\n        for line in f:\\n            for m in re.finditer(r'Native\\\\.([A-Z0-9_]+)\\\\.', line):\\n                ns.add(m.group(1))\\nprint('Native namespaces:', sorted(ns))\\n\\n# 2. Check JOAAT of container_crates, container_crates.ymt in game_scarlett_master.exe and work/\\ndef joaat(s):\\n    h = 0\\n    for b in s.lower().encode():\\n        h = (h + b) & 0xFFFFFFFF\\n        h = (h + (h << 10)) & 0xFFFFFFFF\\n        h ^= (h >> 6)\\n    h = (h + (h << 3)) & 0xFFFFFFFF\\n    h ^= (h >> 11)\\n    h = (h + (h << 15)) & 0xFFFFFFFF\\n    return h\\nfor s in ['container_crates', 'container_crates.ymt', 'container_crate', 'container_crate.ymt']:\\n    print(s, hex(joaat(s)))\\n\\\"\"","WaitMsBeforeAsync":"10000","toolSummary":"\"List Native namespaces and compute crate JOAAT hashes\""}}]}
