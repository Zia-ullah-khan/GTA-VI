    <Item key="GENERIC_PUSH_UPPERBODY" type="CDoorInteractionDataSet">
      <Archetypes>Upperbody Generic</Archetypes>
      <PedSpeedData>
        <AuthoredEntrySpeed type="CAISpeed">
