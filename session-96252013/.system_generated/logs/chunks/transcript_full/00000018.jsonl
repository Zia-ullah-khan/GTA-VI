files.append((fp, magic, idx, sz))\n                                    break\n            except Exception as e:\n                pass\n\nprint(f'GXT2 scan complete. Found: {len(found_files)}')\nfor fp, magic, offset, sz in found_files:\n    print(f'File: {fp} | Magic: {magic} @ offset {offset} | Size: {sz}')\n\"","Cwd":"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK","NotificationTimeoutSeconds":60,"WaitMsBeforeAsync":10000,"toolAction":"Scanning for GXT2 localization tables","toolSummary":"Search for GXT2 magic in work/ and build"}}]}
