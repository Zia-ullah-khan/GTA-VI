re Interlude\", \"\", \"normal\"),\n        (\"43. Prepare for Vice City\", \"Packing Up & Liquidating Assets\", \"\", \"normal\"),\n        (\"44. Checking Out\", \"Departing Port Gellhorn for VC\", \"Ch. 2 Climax\", \"point_of_no_return\"),\n    ]\n    \n    all_cards = [m_col1, m_col2, m_col3, m_col4]\n    for c_idx, col in enumerate(all_cards):\n        cx = cols_x[c_idx]\n        y_start = 10.0\n        gap = 1.45\n        for r_idx, (t, sub, badge, ctype) in enumerate(col):\n            cy = y_start - r_idx * gap\n            draw_card(ax, cx, cy, w, h, t, sub, badge, ctype)\n            if r_idx < len(col) - 1:\n                draw_arrow(ax, (cx + w/2, cy), (cx + w/2, cy - (gap - h)), color=\"#38bdf8\")\n                \n    draw_arrow(ax, (cols_x[0] + w, 2.75 + h/2), (cols_x[1], 10.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    draw_arrow(ax, (cols_x[1] + w, 2.75 + h/2), (cols_x[2], 10.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    draw_arrow(ax, (cols_x[2] + w, 2.75 + h/2), (cols_x[3], 10.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    \n    ch3_x, ch3_y = cols_x[3], 10.0 - 4*1.45\n    draw_card(ax, ch3_x, ch3_y, w, 0.9, \"→ TRANSITION TO CHAPTER 3\", \"Destination: Vice City (Tits, Ass, Drug Money)\", \"\", \"point_of_no_return\")\n    draw_arrow(ax, (cols_x[3] + w/2, 10.0 - 3*1.45), (cols_x[3] + w/2, ch3_y + 0.9), color=\"#ef4444\")\n    \n    out_path = os.path.join(WORKSPACE_DIR, \"flowchart_chapter_2.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\n# ==========================================\n# 3. CHAPTER 3: TITS, ASS, DRUG MONEY\n# ==========================================\ndef render_chapter_3():\n    fig, ax = plt.subplots(figsize=(20, 13), dpi=200)\n    fig.patch.set_facecolor(BG_COLOR)\n    ax.set_facecolor(BG_COLOR)\n    ax.set_xlim(0, 20)\n    ax.set_ylim(0, 13)\n    ax.axis(\"off\")\n    \n    setup_header(\n        ax,\n        \"GRAND THEFT AUTO VI — CHAPTER 3: TITS