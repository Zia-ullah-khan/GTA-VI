		<Item key="GENERIC_EXIT_SCENARIO" type="CConversationTopic">
			<!-- === Topic Data === -->
			<ResponseCondition type="CAIConditionAnd">
				<Conditions>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionInSameGroup">
							<PedA>PrimaryEntity</PedA>
							<PedB>SecondaryEntity</PedB>
							<GroupTypes>GROUP_FLAG_Ped</GroupTypes>
						</Condition>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionReferenced">
							<Name>PED_IS_IN_BAD_WEATHER</Name>
						</Condition>
					</Condition>
				</Conditions>
			</ResponseCondition>
			<SupporterCondition type="NULL"/>
			<MinGlobalRepeatTime value="5000"/>
			<MinPerPedRepeatTime value="120000"/>
			<Priority value="0"/>
			
			<!-- === Response Data === -->
			<ResponseRoles>
				<Item key="INITIATOR">
					<ResponseName>Conversation_TopicTemplate_4Lines_Initiator</ResponseName>
					<SpeechRuleSet>GenericTailOffOutro</SpeechRuleSet>
				</Item>
				<Item key="RESPONDER">
					<ResponseName>Conversation_TopicTemplate_4Lines_Responder</ResponseName>
					<SpeechRuleSet>GenericTailOffOutro</SpeechRuleSet>
				</Item>
			</ResponseRoles>
		</Item>
		
