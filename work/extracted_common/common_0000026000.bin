						<Item ref="POST_DISPUTE_WARN_MALE"/>
						<Item ref="POST_DISPUTE_WARN_FEMALE"/>
					</TopicResponses>
					<MinDistance value="2.0f"/>
					<MaxDistance value="9.0f"/>
				</Item>
			</Variations>
		</Item>

