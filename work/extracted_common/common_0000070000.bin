    <Item type="CDamageModifierMulti">
      <Name>ArmourHit_NoShotgun</Name>
      <Condition type="CDamageConditionNot">
        <Condition type="CDamageConditionFromAmmoType">
          <AmmoTypes>
            <Item>AMMO_SHOTGUN_REGULAR</Item>
          </AmmoTypes>
        </Condition>
      </Condition>
      <Modifiers>
        <Item type="CDamageModifierPreventBleedout" />
        <Item type="CDamageModifierNoCriticalOrFatalDamage" />
      </Modifiers>
      <NextModifierPolicy>OnConditionSuccess</NextModifierPolicy>
      <NextModifier type="CDamageModifierMulti">
        <Name>ArmourHit_NoShotgun_LessThanHalfArmour</Name>
        <Condition type="CDamageConditionRatio">
          <ValueType>ArmourDamage</ValueType>
          <RHS value="0.5"/>
          <CompareType>LESS_OR_EQUAL</CompareType>
        </Condition>
        <Modifiers>
          <Item type="CDamageModifierNoCriticalOrFatalDamage" />
          <Item type="CDamageModifierAddAbstract">
            <ValueType>HealthDamage</ValueType>
            <Value type="CMultiplyProvider">
              <First type="CFloatProvider">
                <Value value="0.250000"/>
              </First>
              <Second type="COriginalDamageProvider"/>
            </Value>
          </Item>
        </Modifiers>
        <NextModifierPolicy>OnConditionFailure</NextModifierPolicy>
        <NextModifier type="CDamageModifierSuppressRagdoll">
            <Condition type="CDamageConditionNot">
              <Condition type="CDamageConditionOr">
                <Conditions>
                <Item type="CDamageConditionFromThrownWeapon"/>
                <Item type="CDamageConditionFromWeaponAndAmmoGroup">
                  <WeaponGroups>
                    <Item>GROUP_SPORTS</Item>
                    <Item>GROUP_THROWN</Item>
                    <Item>GROUP_SNIPER</Item>
                  </WeaponGroups>
                </Item>
                </Conditions>
              </Condition>
            </Condition>
        </NextModifier>
      </NextModifier>
    </Item>

    <Item type="CDamageModifierMulti">
      <Name>ArmourHit_Shotgun</Name>
