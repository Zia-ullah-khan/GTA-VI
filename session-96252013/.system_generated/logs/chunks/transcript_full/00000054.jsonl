   draw_arrow(ax, m50_pt, (s1_x1, s2_y + h/2), rad=-0.15)\n651:     \n652:     # STRAND 3: RAUL & RANDY (Cartel & Cars)\n653:     draw_mission(ax, s1_x1, 7.8, w, h, \"53. Car Service\", \"Luxury Vehicle Interception\", font_size=8.0)\n654:     draw_mission(ax, s1_x1, 6.2, w, h, \"57. Caught Slipping\", \"Surviving Competitor Ambush\", font_size=8.0)\n655:     draw_mission(ax, s1_x1, 4.6, w, h, \"58. Crosstown Traffic\", \"Highway Pursuit & Escape\", font_size=8.0)\n656:     draw_mission(ax, s1_x1, 3.0, w, h, \"59. Credit Check\", \"Background Probe on Raul\", font_size=8.0)\n657:     draw_mission(ax, s1_x2, 3.0, w, h, \"60. Steal Zorrusso\", \"Exotic Supercar Booster\", font_size=8.0)\n658:     \n659:     draw_arrow(ax, m50_pt, (s1_x1, 7.8 + h/2), rad=0.15)\n660:     draw_arrow(ax, (s1_x1 + w/2, 7.8), (s1_x1 + w/2, 7.25))\n661:     draw_arrow(ax, (s1_x1 + w/2, 6.2), (s1_x1 + w/2, 5.65))\n662:     draw_arrow(ax, (s1_x1 + w/2, 4.6), (s1_x1 + w/2, 4.05))\n663:     draw_arrow(ax, (s1_x1 + w, 3.0 + h/2), (s1_x2, 3.0 + h/2))\n664:     \n665:     # HEIST SCOPE OUT CONVERGENCE (Mission 61)\n666:     heist_scope_y = 6.2\n667:     draw_diamond(ax, s1_x2 + w/2, heist_scope_y + h/2, 2.2, 0.95, \"61. SINFRONTERA BANK\\nSCOPE OUT & HEIST BOARD\\n(All 3 Strands Converge!)\", font_size=7.2)\n668:     \n669:     draw_arrow(ax, (s1_x2 + w/2, 13.0), (s1_x2 + w/2, heist_scope_y + h/2 + 0.95), rad=-0.2)\n670:     draw_arrow(ax, (s1_x2 + w/2, 9.5), (s1_x2 + w/2, heist_scope_y + h/2 + 0.95))\n671:     draw_arrow(ax, (s1_x2 + w/2, 4.05), (s1_x2 + w/2, heist_scope_y + h/2 - 0.95))\n672:     \n673:     # ---------------- 3 CONCURRENT PREP TRACKS ----------------\n674:     prep_box = patches.FancyBboxPatch(\n675:         (13.2, 1.2), 12.2, 12.8,\n676:         boxstyle=\"round,pad=0.03,rounding_size=0.15\",\n677:         linewidth=1.4,\n678:         edgecolor=\"#ca8a04\",\n679:         facecolor=\"#26292e\",\n680:         zorder=1\n681:     )\n682:     ax.add_patch(prep_box)\n683:     ax.text(19.3, 13.5, \"SINFRONTERA BANK HEIST PREPARATION PIPELINE (3 CONCURRENT TRACKS)\", ha=\"center\", va=\"center\", fontsize=9.2, fontweight=\"bold\", color=\"#fde047\")\n684:     \n685:     pw = 3.6\n686:     t1_x = 13.6   # Track 1: Safecracker\n687:     t2_x = 17.5   # Track 2: Explosives\n688:     t3_x = 21.4   # Track 3: Codes & Van\n689:     \n690:     # Track 1: Safecracker (62 -> 65 -> 68)\n691:     draw_mission(ax, t1_x, 11.5, pw, 1.05, \"62. Security Expert\", \"Retrieve Nicole Park\", font_size=7.8)\n692:     draw_mission(ax, t1_x, 9.7, pw, 1.05, \"65. Safe Word\", \"Safe-Cracking Drill\", font_size=7.8)\n693:     draw_mission(ax, t1_x, 7.9, pw, 1.05, \"68. Cooties\", \"Disinfecting Evidence\", font_size=7.8)\n694:     draw_arrow(ax, (t1_x + pw/2, 11.5), (t1_x + pw/2, 10.75))\n695:     draw_arrow(ax, (t1_x + pw/2, 9.7), (t1_x + pw/2, 8.95))\n696:     \n697:     # Track 2: Explosives (63 -> 66 -> 69)\n698:     draw_mission(ax, t2_x, 11.5, pw, 1.05, \"63. Company Property\", \"Steal Vault Charges\", font_size=7.8)\n699:     draw_mission(ax, t2_x, 9.7, pw, 1.05, \"66. Hidden Charges\", \"Rig 3 Regional Towers\", font_size=7.8)\n700:     draw_mission(ax, t2_x, 7.9, pw, 1.05, \"69. Bricked Up\", \"Reinforce Extraction Route\", font_size=7.8)\n701:     draw_arrow(ax, (t2_x + pw/2, 11.5), (t2_x + pw/2, 10.75))\n702:     draw_arrow(ax, (t2_x + pw/2, 9.7), (t2_x + pw/2, 8.95))\n703:     \n704:     # Track 3: Codes & Van (64 -> 67)\n705:     draw_mission(ax, t3_x, 11.5, pw, 1.05, \"64. The Missing Link\", \"Interrogate Monty for Codes\", font_size=7.8)\n706:     draw_mission(ax, t3_x, 9.7, pw, 1.05, \"67. Ride or Die\", \"Armored Extraction Van\", font_size=7.8)\n707:     draw_arrow(ax, (t3_x + pw/2, 11.5), (t3_x + pw/2, 10.75))\n708:     \n709:     # Bus bar from Scope Out to Preps\n710:     y_bus = 12.8\n711:     gx_bus = 12.8\n712:     m61_exit_y = heist_scope_y + h/2\n713:     ax.plot([s1_x2 + w, gx_bus, gx_bus, t3_x + pw/2], [m61_exit_y, m61_exit_y, y_bus, y_bus], color=\"#ffffff\", lw=1.8, zorder=2)\n714:     draw_arrow(ax, (t1_x + pw/2, y_bus), (t1_x + pw/2, 12.55))\n715:     draw_arrow(ax, (t2_x + pw/2, y_bus), (t2_x + pw/2, 12.55))\n716:     draw_arrow(ax, (t3_x + pw/2, y_bus), (t3_x + pw/2, 12.55))\n717:     \n718:     # 70. THE CARTEL HEIST\n719:     heist_fin_y = 4.2\n720:     draw_mission(ax, 14.5, heist_fin_y, 9.6, 1.45, \"70. THE CARTEL HEIST\", \"Sinfrontera National Bank Vault Raid ($10.5M Take)\\n★ Keep $75,000 for Chapter 4 Abe Gate! ★\", is_climax=True, font_size=9.2)\n721:     \n722:     draw_arrow(ax, (t1_x + pw/2, 7.9), (t1_x + pw/2, heist_fin_y + 1.45), color=\"#ea580c\", lw=1.8)\n723:     draw_arrow(ax, (t2_x + pw/2, 7.9), (t2_x + pw/2, heist_fin_y + 1.45), color=\"#ea580c\", lw=1.8)\n724:     ax.plot([t3_x + pw/2, t3_x + pw/2, 22.8], [9.7, 6.5, 6.5], color=\"#ea580c\", lw=1.8, zorder=2)\n725:     draw_arrow(ax, (22.8, 6.5), (22.8, heist_fin_y + 1.45), color=\"#ea580c\", lw=1.8)\n726:     \n727:     # Transition to Chapter 4\n728:     trans_x = 14.5 + 4.8 - w/2\n729:     draw_speedrun_badge(ax, trans_x, 1.8, w, 1.15, \"CHAPTER 4 TRANSITION\", \"Hard cut to Ocean Beach (VC)!\\nMaintain $75k balance.\")\n730:     draw_arrow(ax, (trans_x + w/2, heist_fin_y), (trans_x + w/2, 1.8 + 1.15), color=\"#f43f5e\", lw=2.0)\n731:     \n732:     out_file = os.path.join(ARTIFACT_DIR, \"flowchart_chapter_3.png\")\n733:     plt.savefig(out_file, bbox_inches=\"tight\", facecolor=BG_COLOR)\n734:     plt.close()\n735:     copy_to_all(\"flowchart_chapter_3.png\")\n736:     print(\"Rendered Chapter 3 (Classic Design).\")\n737: \n738: # =========================================================================\n739: # 4. CHAPTER 4: VICE CITY METRO & AIRPORT HEIST (CLASSIC DESIGN)\n740: # =========================================================================\n741: def render_chapter_4():\n742:     fig, ax = plt.subplots(figsize=(25, 14), dpi=200)\n743:     fig.patch.set_facecolor(BG_COLOR)\n744:     ax.set_facecolor(BG_COLOR)\