                <Condition type="CDamageConditionHasPlayerBeenDamagedInCurrentCombat" />
              </Item>
              <Item type="CDamageConditionIsTimeWithinSecondsSinceLocalPlayerFirstDamagedInCombat">
                <UpperLimit value="2.0"/>
              </Item>
            </Conditions>
          </Item>
        </Conditions>
      </Condition>
      <Modifiers>
        <Item type="CDamageModifierNonFatalDamage" />
        <Item type="CDamageModifierMultiply">
          <Value value="1.00"/>
        </Item>
      </Modifiers>
    </Item>

    <Item type="CDamageModifierMultiply">
      <Name>Hit_PlayerSPWhileHealing</Name>
      <Condition type="CDamageConditionAnd">
        <Conditions>
          <Item type="CDamageConditionFromDamageType">
            <DamageTypes>
              <Item>MELEE</Item>
              <Item>BULLET</Item>
            </DamageTypes>
          </Item>
          <Item type="CDamageConditionIsInItemInteractionState">
            <Entity>Victim</Entity>
            <Tags>
              <Item>Healing</Item>
            </Tags>
          </Item>
        </Conditions>
      </Condition>
      <Value value="0.25"/>
    </Item>

    <Item type="CDamageModifierMulti">
        <Name>Hit_PlayerWithStun</Name>
        <Condition type="CDamageConditionAnd">
            <Conditions>
                <Item type="CDamageConditionVictimIsPlayer" />
                <Item type="CDamageConditionFromAmmoType">
                    <AmmoTypes>
                        <Item>AMMO_SPECIAL_STUN</Item>
                    </AmmoTypes>
                </Item>
                <Item type="CDamageConditionOr">
                  <Conditions>
                    <Item type="CDamageConditionNot">
                      <Condition type="CDamageConditionVictimReadyToBeBusted">
                          <MaxTimesShocked value="1"/>
                      </Condition>
                    </Item>
                    <Item type="CDamageConditionAnd">
                        <Conditions>
                          <Item type="CDamageConditionNot">
                              <Condition type="CDamageConditionVictimReadyToBeBusted">
                                  <MaxTimesShocked value="3"/>
                              </Condition>
                          </Item>
                          <Item type="CDamageConditionNot">
                              <Condition type="CDamageConditionOr">
                                  <Conditions>
                                      <Item type="CDamageConditionRatio">
                                          <ValueType>StaminaDamage</ValueType>
                                          <Entity>Victim</Entity>
                                          <RHS value="0.67"/>
                                          <CompareType>LESS</CompareType>
                                      </Item>
                                      <Item type="CDamageConditionVictimIsPlayingGetup">
                                          <ExcludeLocomotion value="true" />
                                          <IncludeMelee value="true" />
                                      </Item>
                                  </Conditions>
                            </Condition>
                          </Item>
                        </Conditions>
                    </Item>
                  </Conditions>
                  </Item>
            </Conditions>
        </Condition>
        <Modifiers>
            <Item type="CDamageModifierAddRatio">
                <ValueType>StaminaDamage</ValueType>
                <Value value="0.66" />
            </Item>
            <Item type="CDamageModifierRequestFullBodyReaction" />
        </Modifiers>
        <NextModifierPolicy>OnConditionFailure</NextModifierPolicy>
        <NextModifier type="CDamageModifierMulti">
            <Condition type="CDamageConditionFromAmmoType">
                <AmmoTypes>
                    <Item>AMMO_SPECIAL_STUN</Item>
                </AmmoTypes>
            </Condition>
            <Modifiers>
                <Item type="CDamageModifierAdd">
                    <ValueType>StaminaDamage</ValueType>
                    <Value value="25.000000" />
                </Item>
            </Modifiers>
        </NextModifier>
    </Item>

