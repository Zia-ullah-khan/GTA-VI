{"step_index":1369,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-25T23:03:41Z","content":"Created At: 2026-11-25T18:03:41-05:00\nCompleted At: 2026-11-25T18:03:44-05:00\nCreated At: 2026-11-25T18:03:41-05:00\nCompleted At: 2026-11-25T18:03:44-05:00\nShowing lines 1-125 of 125\n1: \"\"\"Load the decoded game-data sources used by the final deliverables.\r\n2: \r\n3: Every loader returns plain data plus the artifact location it came from, so each output field can cite its origin.\r\n4: \"\"\"\r\n5: \r\n6: import json\r\n7: from pathlib import Path\r\n8: \r\n9: LISTS_SOURCE = \"pack/story000/story000.rpf @ 0x3e30b5000 (PSO, 262,496 bytes inflated)\"\r\n10: STORY_LIST_KEY = \"b95219d4\"\r\n11: SIDE_LIST_KEY = \"4f7ef576\"\r\n12: VARIANT_MAP_KEY = \"54f9a1be\"\r\n13: LIST_BLOCK = 24\r\n14: LIST_VALUE_FIELD = \"063fa3f2\"\r\n15: LIST_KEY_FIELD = \"6098a50e\"\r\n16: LIST_ITEMS_FIELD = \"ef2037f0\"\r\n17: LIST_TYPE_FIELD = \"5538a0a1\"\r\n18: VARIANT_ROWS_FIELD = \"d05707e4\"\r\n19: VARIANT_BASE_FIELD = \"26516057\"\r\n20: VARIANT_ITEMS_FIELD = \"68eb1b31\"\r\n21: \r\n22: TRIGGER_SOURCES = {\r\n23:     \"story000\": \"pack/story000/story000.rpf @ 0x3e2372000 (PSO, 2,166,996 bytes inflated)\",\r\n24:     \"levels\": \"levels.rpf @ 0x11bb116000 (PSO, 1,498,864 bytes inflated)\",\r\n25: }\r\n26: REQUIRED_PLAYER_KEY = \"db880157\"\r\n27: CONTACT_KEY = \"f0af2c92\"\r\n28: HOUR_START_KEY = \"1fd5bb99\"\r\n29: HOUR_END_KEY = \"b376ad2b\"\r\n30: FLAGS_KEY = \"832592a0\"\r\n31: REQUIRED_PLAYER_VALUES = {\"4e21d02a\": \"Lucia\", \"56d7fe7a\": \"Jason\"}\r\n32: \r\n33: \r\n34: def load_json(path: Path):\r\n35:     return json.loads(path.read_text(encoding=\"utf-8\"))\r\n36: \r\n37: \r\n38: class IdResolver:\r\n39:     \"\"\"Turns '<hash>' or '<hash>:<NAME>' into a display ID, using only exact joaat matches recorded earlier.\"\"\"\r\n40: \r\n41:     def __init__(self, recovered_names: dict[str, list[str]], titles: dict[str, str]):\r\n42:         self._recovered = {key: names[0] for key, names in recovered_names.items() if len(names) == 1}\r\n43:         self._titles = titles\r\n44: \r\n45:     def Name(self, value: str) -> str:\r\n46:         if \":\" in value:\r\n47:             return value.split(\":\", 1)[1]\r\n48: \r\n49:         return self._recovered.get(value, f\"0x{value.upper()}\")\r\n50: \r\n51:     def IsRecovered(self, value: str) -> bool:\r\n52:         return \":\" not in value and value in self._recovered\r\n53: \r\n54:     def Title(self, value: str) -> str | None:\r\n55:         return self._titles.get(value.split(\":\", 1)[0])\r\n56: \r\n57: \r\n58: def _list_rows(tree: dict) -> list[dict]:\r\n59:     for block in tree[\"blocks\"]:\r\n60:         if block[\"number\"] == LIST_BLOCK:\r\n61:             return [row for row in block[\"rows\"] if isinstance(row.get(LIST_VALUE_FIELD), dict)]\r\n62: \r\n63:     raise ValueError(f\"Block {LIST_BLOCK} missing from list tree\")\r\n64: \r\n65: \r\n66: def load_named_list(tree: dict, key: str) -> dict:\r\n67:     for row in _list_rows(tree):\r\n68:         if row[LIST_KEY_FIELD] == key:\r\n69:             value = row[LIST_VALUE_FIELD]\r\n70:             return {\"key\": key, \"type_hash\": value[LIST_TYPE_FIELD], \"items\": value[LIST_ITEMS_FIELD]}\r\n71: \r\n72:     raise ValueError(f\"List {key} missing from list tree\")\r\n73: \r\n74: \r\n75: def load_variant_map(tree: dict) -> list[dict]:\r\n76:     for row in _list_rows(tree):\r\n77:         if row[LIST_KEY_FIELD] == VARIANT_MAP_KEY:\r\n78:             return [{\"base\": entry[VARIANT_BASE_FIELD], \"variants\": entry[VARIANT_ITEMS_FIELD]}\r\n79:                     for entry in row[LIST_VALUE_FIELD][VARIANT_ROWS_FIELD]]\r\n80: \r\n81:     raise ValueError(\"Variant map missing from list tree\")\r\n82: \r\n83: \r\n84: def _trigger(row: dict, source: str, contact_names: dict[str, list[str]]) -> dict:\r\n85:     properties = {**row[\"hash_properties\"], **row[\"int_properties\"]}\r\n86:     contact = properties.get(CONTACT_KEY)\r\n87:     contact_hash = contact.split(\":\", 1)[0] if contact else None\r\n88:     required = properties.get(REQUIRED_PLAYER_KEY)\r\n89:     return {\r\n90:         \"source\": TRIGGER_SOURCES[source],\r\n91:         \"position\": row[\"positions\"][0] if row[\"positions\"] else None,\r\n92:         \"required_player_hash\": f\"0x{required.upper()}\" if required else None,\r\n93:         \"required_player\": REQUIRED_PLAYER_VALUES.get(required) if required else None,\r\n94:         \"contact_hash\": f\"0x{contact_hash.upper()}\" if contact_hash else None,\r\n95:         \"contact_name\": (contact_names.get(contact_hash) or [None])[0] if contact_hash else None,\r\n96:         \"hour_start\": properties.get(HOUR_START_KEY),\r\n97:         \"hour_end\": properties.get(HOUR_END_KEY),\r\n98:         \"flags\": properties.get(FLAGS_KEY),\r\n99:     }\r\n100: \r\n101: \r\n102: def load_triggers(paths: dict[str, Path], contact_names: dict[str, list[str]]) -> dict[str, list[dict]]:\r\n103:     \"\"\"Map mission ID -> trigger records, one per data file that defines it.\"\"\"\r\n104:     triggers = {}\r\n105:     for source, path in paths.items():\r\n106:         for row in load_json(path):\r\n107:             if \":\" not in row[\"id\"]:\r\n108:                 continue\r\n109: \r\n110:             name = row[\"id\"].split(\":\", 1)[1]\r\n111:             triggers.setdefault(name, []).append(_trigger(row, source, contact_names))\r\n112: \r\n113:     return triggers\r\n114: \r\n115: \r\n116: def load_titles(table_path: Path) -> dict[str, str]:\r\n117:     return {key: value for key, value in load_json(table_path).items() if value}\r\n118: \r\n119: \r\n120: def flatten_text_keys(mission_text: dict) -> dict[str, str]:\r\n121:     flat = dict(mission_text.get(\"other_keys\", {}))\r\n122:     for keys in mission_text[\"missions\"].values():\r\n123:         flat.update(keys)\r\n124: \r\n125:     return {key.upper(): value for key, value in flat.items()}\r"}
