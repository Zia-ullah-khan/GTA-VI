<?xml version="1.0" encoding="UTF-8"?>
<CAnimalAttackBehaviours>
  <Behaviours>
    <Item type="CAnimalAttackBehaviour">
      <Name>COYOTE_PACK_ATTACK</Name>
      <AnimalTuning>SPECIES_COYOTE</AnimalTuning>
      <Task>TASK_PACK_ATTACK</Task>
      <Triggers>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionIsHuman">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionIsUsingScenario">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionNot">
                <Condition type="CAIConditionScenarioPedIsStanding">
                  <Ped>SecondaryEntity</Ped>
                </Condition>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_SURROUND</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionPedHealthPercentageInRange">
            <Ped>SecondaryEntity</Ped>
            <LowerBound value="0.0f" />
            <UpperBound value="0.0f" />
          </Condition>
          <AttackState>PACK_FACE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionAttackGroupMeleeMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionPackPermitsAttack" />
            </Conditions>
          </Condition>
          <AttackState>PACK_MELEE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAwayFromPackOffset" />
          <AttackState>PACK_SURROUND</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <AttackState>PACK_FACE</AttackState>
        </Item>
      </Triggers>
    </Item>
    <Item type="CAnimalAttackBehaviour">
      <Name>DOMESTIC_DOG_PACK_ATTACK</Name>
      <AnimalTuning>SPECIES_DOMESTIC_DOG</AnimalTuning>
      <Task>TASK_PACK_ATTACK</Task>
      <Triggers>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionIsHuman">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionIsUsingScenario">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionNot">
                <Condition type="CAIConditionScenarioPedIsStanding">
                  <Ped>SecondaryEntity</Ped>
                </Condition>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_SURROUND</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionPedHealthPercentageInRange">
            <Ped>SecondaryEntity</Ped>
            <LowerBound value="0.0f" />
            <UpperBound value="0.0f" />
          </Condition>
          <AttackState>PACK_FACE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionIsHuman">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionPackPermitsAttack" />
              <Condition type="CAIConditionAttackGroupGrapplingMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionAttackGroupMeleeMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionDistanceBetweenEntities">
                <LowerBound value="-1.0f" />
                <UpperBound value="10.0f" />
              </Condition>
              <Condition type="CAIConditionAnd">
                <Conditions>
                 <Condition type="CAIConditionIsLawPed">
                   <Ped>PrimaryEntity</Ped>
                  </Condition>
                  <Condition type="CAIConditionAnimalTimeSinceAttackState">
                    <Time value="3.0f" />
                    <AttackStates>
                      <Item>PACK_GRAPPLE</Item>
                    </AttackStates>
                  </Condition>
                </Conditions>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_GRAPPLE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionWasDamagedByPlayer">
                <Ped>PrimaryEntity</Ped>
			    <PlayerPed>SecondaryEntity</PlayerPed>
              </Condition>
              <Condition type="CAIConditionAnimalTimeSinceAttackState">
                <Time value="5.0f" />
                <AttackStates>
                  <Item>PACK_GRAPPLE</Item>
                </AttackStates>
              </Condition>
              <Condition type="CAIConditionNot">
                <Condition type="CAIConditionIsInjured">
                  <Ped>PrimaryEntity</Ped>
                </Condition>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_GRAPPLE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
		  <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionAnimalHasOwner">
                <Ped>PrimaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionAnimalTimeSinceAttackState">
                <Time value="5.0f" />
                <AttackStates>
                  <Item>PACK_GRAPPLE</Item>
                </AttackStates>
              </Condition>
		      <Condition type="CAIConditionOr">
                <Conditions>
                  <Condition type="CAIConditionIsBeingShotAt">
                    <Ped>TertiaryEntity</Ped>
                  </Condition>
                  <Condition type="CAIConditionIsDead">
                    <Ped>TertiaryEntity</Ped>
                  </Condition>
                  <Condition type="CAIConditionIsKnockedOut">
                    <Ped>TertiaryEntity</Ped>
                  </Condition>
                </Conditions>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_GRAPPLE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionNot">
                <Condition type="CAIConditionIsEasyPrey">
                  <PedA>SecondaryEntity</PedA>
                  <PedB>PrimaryEntity</PedB>
                </Condition>
              </Condition>
              <Condition type="CAIConditionDistanceBetweenEntities">
                <LowerBound value="-1.0f" />
                <UpperBound value="1.00f" />
              </Condition>
			  <Condition type="CAIConditionSpeed">
			    <Ped>PrimaryEntity</Ped>
			    <Speed>Stand</Speed>
			    <CheckCurrent value="true" />
			  </Condition>
              <Condition type="CAIConditionPackAttackCanDodgeBack" />
            </Conditions>
          </Condition>
          <AttackState>PACK_DODGE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionIsHuman">
                <Ped>SecondaryEntity</Ped>
              </Condition>
              <Condition type="CAIConditionPackPermitsAttack" />
              <Condition type="CAIConditionAttackGroupGrapplingMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionAttackGroupMeleeMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionDistanceBetweenEntities">
                <LowerBound value="-1.0f" />
                <UpperBound value="10.0f" />
              </Condition>
              <Condition type="CAIConditionOr">
                <Conditions>
                  <Condition type="CAIConditionArePedScriptConfigFlagsSet">
                    <ConfigFlags>PCF_DiesInstantlyToMeleeFromAnimals</ConfigFlags>
                    <Ped>SecondaryEntity</Ped>
                  </Condition>
                  <Condition type="CAIConditionAnd">
                    <Conditions>
                      <Condition type="CAIConditionPedHealthPercentageInRange">
                        <Ped>SecondaryEntity</Ped>
                        <LowerBound value="0.00f" />
                        <UpperBound value="0.50f" />
                      </Condition>
                      <Condition type="CAIConditionAnimalTimeSinceAttackState">
                        <Time value="5.0f" />
                        <AttackStates>
                          <Item>PACK_GRAPPLE</Item>
                        </AttackStates>
                      </Condition>
                    </Conditions>
                  </Condition>
                </Conditions>
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_GRAPPLE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionAttackGroupGrapplingMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionAttackGroupMeleeMemberCount">
                <Count value="0" />
              </Condition>
              <Condition type="CAIConditionPackPermitsAttack" />
              <Condition type="CAIConditionNot">
                <Condition type="CAIConditionIsBeingArrestedByAI">
                  <Ped>SecondaryEntity</Ped>
                </Condition>
              </Condition>
              <Condition type="CAIConditionDistanceBetweenEntities">
                <LowerBound value="-1.0f" />
                <UpperBound value="13.0f" />
              </Condition>
            </Conditions>
          </Condition>
          <AttackState>PACK_MELEE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAwayFromPackOffset" />
          <AttackState>PACK_SURROUND</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <Condition type="CAIConditionAnd">
            <Conditions>
              <Condition type="CAIConditionWasAimedAtByPlayer">
                <LowerBound value="-1.0f" />
                <UpperBound value="0.5f" />
              </Condition>
              <Condition type="CAIConditionDistanceBetweenEntities">
                <LowerBound value="-1.0f" />
                <UpperBound value="1.3f" />
              </Condition>
              <Condition type="CAIConditionDirectionRelativeToTarget">
                <FromEntity>SecondaryEntity</FromEntity>
                <TargetEntity>PrimaryEntity</TargetEntity>
                <Threshold value="-0.866f" />
                <LessThan value="true" />
              </Condition>
              <Condition type="CAIConditionPackAttackCanDodgeBack" />
            </Conditions>
          </Condition>
          <AttackState>PACK_DODGE</AttackState>
        </Item>
        <Item type="CAnimalAttackTrigger">
          <AttackState>PACK_FACE</AttackState>
        </Item>
      </Triggers>
    </Item>
