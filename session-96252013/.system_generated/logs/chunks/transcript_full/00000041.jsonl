NT_SRCH\", 573013, None),\r\n33:     (\"MNY_HOTEL\", 572946, \"set\", \"ANT_CHASE\", 573043,\r\n34:      [(\"ANT_CHASE_AUTOLAUNCH\", 573017), (\"ANT_CHASE\", 573030)]),\r\n35:     (\"MNY_HOTEL\", 572946, \"set\", \"ANT_INTRO_APARTMENT\", 573075,\r\n36:      [(\"ANT_INTRO_APARTMENT\", 573049), (\"ANT_INTRO_STORAGE\", 573062)]),\r\n37:     (\"MNY_HOTEL\", 572946, \"set\", \"ANT_RECOV\", 573081, None),\r\n38: ]\r\n39: SAME_BRANCH = [(\"MNY_HOTEL_AUTOLAUNCH\", 572955, \"MNY_HOTEL\")]\r\n40: FINISH_TESTS = [(\"BIL_FINALE_M\", 573115), (\"BIL_FINAL_B\", 573127)]\r\n41: TIME_VARIANTS = [(\"BIL_PICK_NIGHT_TIME_START\", 116320), (\"BIL_PICK_DAY_TIME_START\", 116325)]\r\n42: \r\n43: \r\n44: class LineChecker:\r\n45:     def __init__(self, source_dir: Path, hashes: dict[str, int]):\r\n46:         self._source_dir = source_dir\r\n47:         self._hashes = hashes\r\n48:         self._wanted = defaultdict(set)\r\n49:         self._lines = {}\r\n50: \r\n51:     def want(self, script: str, line: int) -> None:\r\n52:         self._wanted[script].add(line)\r\n53: \r\n54:     def load(self) -> None:\r\n55:         for script, wanted in self._wanted.items():\r\n56:             with (self._source_dir / script).open(\"r\", encoding=\"utf-8\", errors=\"replace\") as handle:\r\n57:                 for number, text in enumerate(handle, start=1):\r\n58:                     if number in wanted:\r\n59:                         self._lines[(script, number)] = text\r\n60: \r\n61:     def require(self, script: str, line: int, mission_id: str) -> str:\r\n62:         text = self._lines.get((script, line), \"\")\r\n63:         if self._hashes[mission_id] not in set(iter_hash_constants(text)):\r\n64:             raise ValueError(f\"{script}:{line} does not contain the hash of {mission_id}\")\r\n65: \r\n66:         return f\"{script}:{line} (0x{self._hashes[mission_id]:08X} = joaat('{mission_id.lower()}'))\"\r\n67: \r\n68: \r\n69: def build_handler_facts(checker: LineChecker) -> list[dict]:\r\n70:     facts = []\r\n71:     for trigger, trigger_line, action, target, target_line, unless in HANDLER_FACTS:\r\n72:         fact = {\r\n73:             \"kind\": \"handler_sets_flag\",\r\n74:             \"function\": \"func_10AA55\",\r\n75:             \"when_argument_equals\": trigger,\r\n76:             \"also_when_argument_equals\": [alias for alias, _, base in SAME_BRANCH if base == trigger],\r\n77:             \"action\": f\"{FLAG_STORE}.Method_0(store, id, 1)\",\r\n78:             \"target\": target,\r\n79:             \"only_if_neither_flag_set\": [name for name, _ in unless] if unless else None,\r\n80:             \"evidence\": [checker.require(CONTROLLER, trigger_line, trigger),\r\n81:                          checker.require(CONTROLLER, target_line, target)],\r\n82:         }\r\n83:         for alias, alias_line, base in SAME_BRANCH:\r\n84:             if base == trigger:\r\n85:                 fact[\"evidence\"].append(checker.require(CONTROLLER, alias_line, alias))\r\n86: \r\n87:         for name, line in unless or []:\r\n88:             fact[\"evidence\"].append(checker.require(CONTROLLER, line, name) + f\" tested with {FLAG_STORE}.Method_1\")\r\n89: \r\n90:         facts.append(fact)\r\n91: \r\n92:     return facts\r\n93: \r\n94: \r\n95: def build_membership_fact(source_dir: Path, names: dict[int, str]) -> dict:\r\n96:     tested = set()\r\n97:     for _, line in find_function(source_dir / CONTROLLER, \"func_109E09\"):\r\n98:         if EQUALITY.search(line):\r\n99:             tested.update(iter_hash_constants(line))\r\n100: \r\n101:     members = sorted(names[value] for value in tested if value in names)\r\n102:     return {\r\n103:         \"kind\": \"id_membership_switch\",\r\n104:         \"function\": \"func_109E09\",\r\n105:         \"returns_1_for_mission_ids\": members,\r\n106:         \"mission_ids_not_in_switch\": sorted(set(names.values()) - set(members)),\r\n107:         \"other_values_in_switch\": sorted(f\"0x{value:08X}\" for value in tested if value not in names),\r\n108:         \"evidence\": [f\"{CONTROLLER} func_109E09 (lines 570880..572796), equality tests ending in 'return 1'\"],\r\n109:     }\r\n110: \r\n111: \r\n112: def build_script_references(refs_index: dict) -> dict[str, list[str]]:\r\n113:     scripts = defaultdict(set)\r\n114:     for script, functions in refs_index.items():\r\n115:         if script in CENTRAL_SCRIPTS:\r\n116:             continue\r\n117: \r\n118:         for entries in functions.values():\r\n119:             for _, mission_id in entries:\r\n120:                 scripts[mission_id].add(script.replace(\".ysc.cs\", \"\"))\r\n121: \r\n122:     return {mission_id: sorted(names) for mission_id, names in sorted(scripts.items())}\r\n123: \r\n124: \r\n125: def main() -> int:\r\n126:     parser = argparse.ArgumentParser()\r\n127:     parser.add_argument(\"source_dir\", type=Path)\r\n128:     parser.add_argument(\"missions_json\", type=Path)\r\n129:     parser.add_argument(\"refs_json\", type=Path)\r\n130:     parser.add_argument(\"--out\", type=Path, required=True)\r\n131:     args = parser.parse_args()\r\n132: \r\n133:     names = load_mission_hashes(args.missions_json)\r\n134:     hashes = {mission_id: value for value, mission_id in names.items()}\r\n135:     checker = LineChecker(args.source_dir, hashes)\r\n136:     for trigger, trigger_line, _, _, target_line, unless in HANDLER_FACTS:\r\n137:         checker.want(CONTROLLER, trigger_line)\r\n138:         checker.want(CONTROLLER, target_line)\r\n139:         for _, line in unless or []:\r\n140:             checker.want(CONTROLLER, line)\r\n141: \r\n142:     for _, line, _ in SAME_BRANCH:\r\n143:         checker.want(CONTROLLER, line)\r\n144: \r\n145:     for _, line in FINISH_TESTS:\r\n146:         checker.want(CONTROLLER, line)\r\n147: \r\n148:     for _, line in TIME_VARIANTS:\r\n149:         checker.want(STORY, line)\r\n150: \r\n151:     checker.load()\r\n152:     try:\r\n153:         facts = build_handler_facts(checker)\r\