<?xml version="1.0" encoding="UTF-8"?>
<CConversationDictionary>

	<!-- The ConversationResponseMap stores both CConversationResponse or CConversationTopic objects (yay inheritance!). -->
	<!-- Make sure to specify what type of object you are defining (type="CConversationTopic", etc.) -->
	
	<!-- The following member is only used in CConversationTransition objects.
		TransitionChance
	
	The following members are only used in CConversationTopic objects. You can define these for a CConversationResponse, but it will do nothing.
		ResponseCondition
		SupporterCondition
		MinGlobalRepeatTime
		MinPerPedRepeatTime
		Priority
		
	The following members are common to both CConversationResponse or CConversationTopic objects:
		ResponseRoles
		BehaviorFlags -->

