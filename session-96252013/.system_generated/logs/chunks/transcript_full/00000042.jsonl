on or 0x140575b40 cipher lives\nfor name, va, sz in [('0x140575b40', 0x140575b40, 200), ('0x1455dbf40', 0x1455dbf40, 220)]:\n    print('===', name, hex(va), '===')\n    r = va_to_raw(va)\n    for insn in md.disasm(data[r:r+sz], va):\n        print(' ', hex(insn.address), insn.mnemonic, insn.op_str)\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Disassemble STNS cipher core functions in exe"}}]}
