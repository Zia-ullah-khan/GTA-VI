rate(card_list):\n821:             cy = y_start - r_idx * gap\n822:             if \"POINT OF NO RETURN\" in sub:\n823:                 draw_speedrun_badge(ax, cx, cy, w, h + 0.1, t, sub, font_size=7.5)\n824:             elif \"$75k Wire\" in sub:\n825:                 draw_speedrun_badge(ax, cx, cy, w, h + 0.1, t, sub, font_size=7.5)\n826:             else:\n827:                 draw_mission(ax, cx, cy, w, h, t, sub, is_climax=is_spec, font_size=8.2)\n828:                 \n829:             if r_idx < len(card_list) - 1:\n830:                 draw_arrow(ax, (cx + w/2, cy), (cx + w/2, cy - (gap - h)))\n831:                 \n832:     # Gutter Bridges\n833:     gx1 = (cols_x[0] + w + cols_x[1]) / 2\n834:     draw_stage_bridge(ax, cols_x[0] + w/2, 12.5 - 4*gap, cols_x[1], 12.5 + h/2, gx1, \"STAGE 2 ▲\\nNEXT\")\n835:     \n836:     gx2 = (cols_x[1] + w + cols_x[2]) / 2\n837:     draw_stage_bridge(ax, cols_x[1] + w/2, 12.5 - 6*gap, cols_x[2], 12.5 + h/2, gx2, \"STAGE 3 ▲\\nNEXT\")\n838:     \n839:     gx3 = (cols_x[2] + w + cols_x[3]) / 2\n840:     draw_stage_bridge(ax, cols_x[2] + w/2, 12.5 - 6*gap, cols_x[3], 12.5 + h/2, gx3, \"STAGE 4 ▲\\nNEXT\")\n841:     \n842:     # Transition to Chapter 5 Badge\n843:     ch5_y = 12.5 - 5.0*gap\n844:     draw_speedrun_badge(ax, cols_x[3], ch5_y, w, 1.25, \"CHAPTER 5 TRANSITION\", \"Hard cut to Endgame Standoff!\\nImmediate point of no return.\")\n845:     draw_arrow(ax, (cols_x[3] + w/2, 12.5 - 3*gap), (cols_x[3] + w/2, ch5_y + 1.25), color=\"#f43f5e\", lw=2.0)\n846:     \n847:     out_file = os.path.join(ARTIFACT_DIR, \"flowchart_chapter_4.png\")\n848:     plt.savefig(out_file, bbox_inches=\"tight\", facecolor=BG_COLOR)\n849:     plt.close()\n850:     copy_to_all(\"flowchart_chapter_4.png\")\n851:     print(\"Rendered Chapter 4 (Classic Design).\")\n852: \n853: # =========================================================================\n854: # 5. CHAPTER 5: THE FINALE & ENDINGS (CLASSIC DESIGN)\n855: # ===========================