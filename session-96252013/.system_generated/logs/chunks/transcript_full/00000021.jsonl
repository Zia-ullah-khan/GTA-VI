 xy=(x_end, y_end), xytext=(x_end - 0.35, y_end),\n134:         arrowprops=dict(arrowstyle=\"->,head_width=0.32,head_length=0.42\", color=color, lw=lw),\n135:         zorder=2\n136:     )\n137:     if badge_text:\n138:         badge_y = (y_turn + y_end) / 2\n139:         ax.text(\n140:             gutter_x, badge_y,\n141:             badge_text,\n142:             ha=\"center\", va=\"center\",\n143:             fontsize=7.2, fontweight=\"bold\",\n144:             color=\"#fde047\",\n145:             bbox=dict(boxstyle=\"round,pad=0.2\", facecolor=\"#281e10\", edgecolor=color, lw=1.0),\n146:             zorder=4\n147:         )\n148: \n149: def draw_column_bridge(ax, x_start, y_start, x_end, y_end, gutter_x, badge_text=\"\", color=\"#f43f5e\", lw=1.8):\n150:     ax.plot([x_start, gutter_x, gutter_x, x_end], [y_start, y_start, y_end, y_end], color=color, lw=lw, zorder=3)\n151:     ax.annotate(\n152:         \"\",\n153:         xy=(x_end, y_end), xytext=(x_end - 0.35, y_end),\n154:         arrowprops=dict(arrowstyle=\"->,head_width=0.32,head_length=0.42\", color=color, lw=lw),\n155:         zorder=3\n156:     )\n157:     if badge_text:\n158:         badge_y = (y_start + y_end) / 2\n159:         ax.text(\n160:             gutter_x, badge_y, badge_text,\n161:             ha=\"center\", va=\"center\", fontsize=6.8, fontweight=\"bold\",\n162:             color=\"#fde047\",\n163:             bbox=dict(boxstyle=\"round,pad=0.18\", facecolor=\"#18140f\", edgecolor=color, lw=1.0),\n164:             zorder=4\n165:         )\n166: \n167: def setup_header(ax, title, subtitle, w_total, y_top=11.5):\n168:     ax.text(\n169:         w_total / 2, y_top,\n170:         title,\n171:         ha=\"center\", va=\"center\",\n172:         fontsize=16,\n173:         fontweight=\"bold\",\n174:         color=\"#ffffff\",\n175:         zorder=5\n176:     )\n177:     ax.text(\n178:         w_total / 2, y_top - 0.45,\n179:         subtitle,\n180:         ha=\"center\", va=\"center\",\n181:         fontsize=10.5,\n182:         color=\"#38bdf8\",\n183:         zorder=5\n184:     )\n185: \n186: def copy_to_all(src_filename):\n187:     art_path = os.path.join(ARTIFACT_DIR, src_filename)\n188:     ws_path = os.path.join(WORKSPACE_DIR, src_filename)\n189:     dl_path = os.path.join(DOWNLOADS_DIR, src_filename)\n190:     if os.path.exists(art_path):\n191:         shutil.copyfile(art_path, ws_path)\n192:         shutil.copyfile(art_path, dl_path)\n193:         print(f\"Synced {src_filename} to workspace and Downloads.\")\n194: \n195: # =========================================================================\n196: # 1. CHAPTER 1: TRUE PARALLEL BRANCHING (MATCHING image_1188e9.jpg GROUND TRUTH)\n197: # =========================================================================\n198: def render_chapter_1():\n199:     fig, ax = plt.subplots(figsize=(24, 18), dpi=200)\n200:     fig.patch.set_facecolor(BG_COLOR)\n201:     ax.set_facecolor(BG_COLOR)\n202:     ax.set_xlim(0, 24)\n203:     ax.set_ylim(0, 18)\n204:     ax.axis(\"off\")\n205:     \n206:     setup_header(\n207:         ax,\n208:         \"GRAND THEFT AUTO VI — CHAPTER 1: JUST LIKE PARADISE\",\n209:         \"Setting: Leonida Keys (Key Lento & Southwind Marina) | Missions 1 - 18 (Ends at Doin' Gone) | 3 Parallel Branches & Gates\",\n210:         24,\n211:         y_top=17.4\n212:     )\n213:     \n214:     w, h = 3.6, 1.05\n215:     center_x = 10.2\n216:     \n217:     # Top: 1. Prologue -> 2. Gone Fishing\n218:     draw_card(ax, center_x, 15.6, w, h, \"1. Prologue\", \"Lucia Prison Counselor Interview\", \"Intro\", \"normal\")\n219:     draw_card(ax, center_x, 14.1, w, h, \"2. Gone Fishing\", \"Jason & Donnie Boat Drop ($140 Mailbox)\", \"\", \"normal\")\n220:     draw_arrow(ax, (center_x + w/2, 15.6), (center_x + w/2, 15.15))\n221:     \n222:     # 3-Track Horizontal Split Bar\n223:     split_y = 13.3\n224:     ax.plot([2.5, 6.2, 12.0], [split_y, split_y, split_y], color=\"#38bdf8\", lw=1.8, zorder=2)\n225:     draw_arrow(ax, (center_x + w/2, 14.1), (center_x + w/2, split_y))\n226:     \n227:     # -------------------------------------------------------------\n228:     # BRANCH 1: UNWANTED ATTENTION & PIPEWORK (Left Track: x = 0.8)\n229:     # -------------------------------------------------------------\n230:     b1_x = 0.8\n231:     draw_arrow(ax, (2.5, split_y), (b1_x + w/2, 12.35))\n232:     draw_card(ax, b1_x, 11.3, w, h, \"6. Unwanted Attention\", \"Cal Trip to Hamlet ($200 Mailbox)\", \"Branch 1\", \"normal\")\n233:     draw_card(ax, b1_x, 9.7, w, h, \"7. Pipework\", \"Marina Maintenance Jobs\", \"Branch 1\", \"normal\")\n234:     draw_arrow(ax, (b1_x + w/2, 11.3), (b1_x + w/2, 10.75))\n235:     \n236:     # Downtime tip box\n237:     p1 = patches.FancyBboxPatch((b1_x, 7.8), w, 1.4, boxstyle=\"round,pad=0.03,rounding_size=0.15\", linewidth=1.2, edgecolor=\"#10b981\", facecolor=\"#064e3b\", zorder=3)\n238:     ax.add_patch(p1)\n239:     ax.text(b1_x + w/2, 8.8, \"⚡ PARALLEL DOWNTIME ROUTE\", ha=\"center\", va=\"center\", fontsize=7.8, fontweight=\"bold\", color=\"#34d399\", zorder=4)\n240:     ax.text(b1_x + w/2, 8.2, \"Clear Missions 6 & 7 during Feng Shui's\\n24-hour waiting window for optimal routing.\", ha=\"center\", va=\"center\", fontsize=6.8, color=\"#ecfdf5\", zorder=4)\n241:     draw_arrow(ax, (b1_x + w/2, 9.7), (b1_x + w/2, 9.2))\n242:     \n243:     # -------------------------------------------------------------\n244:     # BRANCH 2: GEAR UP & JUST A SCRATCH (Middle Track: x = 4.8)\n245:     # -------------------------------------------------------------\n246:     b2_x = 4.8\n247:     draw_arrow(ax, (6.2, split_y), (b2_x + w/2, 12.35))\n248:     draw_card(ax, b2_x, 11.3, w, h, \"3. Gear Up\", \"Pick up Longarm for Brian\", \"Branch 2\", \"normal\")\n249:     draw_card(ax, b2_x, 9.7, w, h, \"4. Just a Scratch\", \"Ganado Repair & Respray\", \"MANDATORY GATE\", \"milestone\")\n250:     draw_arrow(ax, (b2_x + w/2, 11.3), (b2_x + w/2, 10.75))\nThe above conte