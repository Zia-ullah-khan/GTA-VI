    <Item>
      <filename>$(target)/data/credits/credits.rpf</filename>
      <fileType>UI_CREDITS_PACK_FILE</fileType>
    </Item>
  </fileList>
  <flags>Default</flags>
  <mapAddAtPhase value="0" />
  <mapRemoveAtPhase value="0" />
</CDataFileMgr__ContentChangeSetDef>