gle((x, y), w, h, linewidth=1.0, edgecolor=\"#71717a\", facecolor=\"#ffffff\", zorder=3)\n27:     ax.add_patch(rect)\n28:     \n29:     prefix = \"\"\n30:     if icon_type == \"phone\":\n31:         prefix = \"[CALL] \"\n32:     elif icon_type == \"text\":\n33:         prefix = \"[MSG] \"\n34:     elif icon_type == \"mailbox\":\n35:         prefix = \"[MAILBOX] \"\n36:     elif icon_type == \"cash\":\n37:         prefix = \"[$] \"\n38:         \n39:     ax.text(x + w/2, y + h/2, prefix + text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\" if icon_type==\"phone\" else \"normal\", color=\"#09090b\", zorder=4)\n40: \n41: def draw_heart(ax, x, y, w, h, text, skip_label=\"[ANY% SKIP]\", font_size=7.0):\n42:     rect = patches.Rectangle((x, y), w, h, linewidth=1.2, edgecolor=\"#f43f5e\", facecolor=\"#ffe4e6\", zorder=3)\n43:     ax.add_patch(rect)\n44:     t = \"♥ \" + text\n45:     if skip_label:\n46:         t += \"\\n\" + skip_label\n47:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#9f1239\", zorder=4)\n48: \n49: def draw_side(ax, x, y, w, h, text, font_size=7.0):\n50:     rect = patches.Rectangle((x, y), w, h, linewidth=1.2, edgecolor=\"#a855f7\", facecolor=\"#f3e8ff\", zorder=3)\n51:     ax.add_patch(rect)\n52:     t = text + \"\\n[OPTIONAL / SKIP]\"\n53:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#581c87\", zorder=4)\n54: \n55: def draw_diamond(ax, cx, cy, rx, ry, text, font_size=6.8):\n56:     pts = [[cx, cy + ry], [cx + rx, cy], [cx, cy - ry], [cx - rx, cy]]\n57:     poly = patches.Polygon(pts, closed=True, linewidth=1.4, edgecolor=\"#cbd5e1\", facecolor=\"#ffffff\", zorder=3)\n58:     ax.add_patch(poly)\n59:     ax.text(cx, cy, text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#0f172a\", zorder=4)\n60: \n61: def draw_speedrun_badge(ax, x, y, w, h, title, note, font_size=6.8):\n62:     rect = patches.Rectangle((x, y), w, h, linewidth=1.4, edgecolor=\"#10b981\", facecolor=\"#064e3b\", zorder=3)\n63:     ax.add_patch(rect)\n64:     ax.text(x + w/2, y + h - 0.22, \"⚡ \" + title, ha=\"center\", va=\"center\", fontsize=font_size+0.6, fontweight=\"bold\", color=\"#34d399\", zorder=4)\n65:     ax.text(x + w/2, y + h/2 - 0.1, note, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#ecfdf5\", zorder=4)\n66: \n67: def draw_arrow(ax, p1, p2, color=\"#ffffff\", lw=1.2, rad=0.0):\n68:     conn = f\"arc3,rad={rad}\" if rad != 0 else \"arc3,rad=0\"\n69:     ax.annotate(\n70:         \"\",\n71:         xy=p2, xytext=p1,\n72:         arrowprops=dict(\n73:             arrowstyle=\"->,head_width=0.28,head_length=0.38\",\n74:             color=color,\n75:             lw=lw,\n76:             shrinkA=3,\n77:             shrinkB=3,\n78:             connectionstyle=conn\n79:         ),\n80:         zorder=2\n81:     )\n82: \n83: # =========================================================================\n84: # 1. RENDER EXACT CHAPTER 1 MATCHING image_1188e9.jpg GROUND TRUTH + SPEEDRUN\n85: