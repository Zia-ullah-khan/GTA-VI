<?xml version="1.0" encoding="UTF-8"?>

<CHeadbobConditionManager>
	<Conditions>
		<Item type="CHeadbobCondition" key="STANDING">
			<pCondition type="CAIConditionNot">
				<Condition type="CAIConditionArePedConfigFlagsSet">
					<ConfigFlags>CPED_CONFIG_FLAG_IsSitting</ConfigFlags>
					<Ped>PrimaryEntity</Ped>
				</Condition>
			</pCondition>
		</Item>
		<Item type="CHeadbobCondition" key="SITTING">
			<pCondition type="CAIConditionArePedConfigFlagsSet">
				<ConfigFlags>CPED_CONFIG_FLAG_IsSitting</ConfigFlags>
				<Ped>PrimaryEntity</Ped>
			</pCondition>
		</Item>
