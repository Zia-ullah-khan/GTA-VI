 = 0\r\n53:     while blob[cursor:cursor + 2] in ZLIB_HEADERS:\r\n54:         try:\r\n55:             part, consumed = inflate_chunk(blob, cursor)\r\n56:         except zlib.error:\r\n57:             break\r\n58: \r\n59:         parts.append(part)\r\n60:         chunks += 1\r\n61:         cursor = align_up(cursor \n<truncated 212 bytes>\n data[:4]\r\n70:     if len(head) == 4 and all(32 <= b < 127 for b in head):\r\n71:         return head.decode(\"ascii\")\r\n72: \r\n73:     return \"hex:\" + head.hex()\r\n74: \r\n75: \r\n76: def next_nonzero_page(blob: bytes, cursor: int) -> int:\r\n77:     cursor = align_up(cursor, PAGE_SIZE)\r\n78:     zero_page = bytes(PAGE_SIZE)\r\n79:     while cursor < len(blob) and blob[cursor:cursor + PAGE_SIZE] in (zero_page, zero_page[:len(blob) - cursor]):\r\n80:         cursor += PAGE_SIZE\r\n81: \r\n82:     return cursor\r\n83: \r\n84: \r\n85: def opaque_end(blob: bytes, start: int) -> int:\r\n86:     cursor = start + PAGE_SIZE\r\n87:     zero_page = bytes(PAGE_SIZE)\r\n88:     while cursor < len(blob):\r\n89:         page = blob[cursor:cursor + PAGE_SIZE]\r\n90:         if page == zero_page[:len(page)] or page[:2] in ZLIB_HEADERS or page[:4] == RPF_MAGIC:\r\n91:             break\r\n92: \r\n93:         cursor += PAGE_SIZE\r\n94: \r\n95:     return min(cursor, len(blob))\r\n96: \r\n97: \r\n98: def extract(path: Path, out_dir: Path) -> list[Payload]:\r\n99:     blob = path.read_bytes()\r\n100:     payloads = []\r\n101:     cursor = 0\r\n102:     while cursor < len(blob):\r\n103:         cursor = next_nonzero_page(blob, cursor)\r\n104:         if cursor >= len(blob):\r\n105:             break\r\n106: \r\n107:         data, end, chunks = read_zlib_file(blob, cursor)\r\n108:         if chunks > 0:\r\n109:             name = f\"{path.stem}_{cursor:010x}.bin\"\r\n110:             (out_dir / name).write_bytes(data)\r\n111:             payloads.append(Payload(cursor, \"zlib\", end - cursor, len(data), chunks, magic_label(data),\r\n112:       