# ---------- push sphere : Use for ped pushing the grass (land) and lilies on the water
# How far behind the player the grass will stay pushed down (and will gradually get push back up)
pushSphere.pushSphereTailSize 			1.0
# When idle the trail behind the player is set to its minimum (0 length).  This variable tell how fast the tail should grow when we start moving
pushSphere.pushSphereTailGrowSpeed		0.25
# When idle the trail behind the player is set to its minimum (0 length).  When we change direction abruptly, or we stop moving, the tail shrink to 0.
#	This variable tell us how fast it will shring to 0
pushSphere.pushSphereTailShrinkSpeed	1.0
# When idle the grass under the ped can be pushed down.  This is telling us how much it should be pushed down
# 	[0, 1]
# 	0 = not push down at all
#	1 = push down to its maximum
pushSphere.pushSphereStrengthIdle		0.5
# the tail brighness can be modified
#	[0, 1]
#	0 = change down to black
#	1 = unchanged
pushSphere.pushSphereDimColor			0.8
# the grass is being pushed forward mostly.  This variable allow the grass to be push side way a little as well
#	[0, 1]
#	0 = no side push at all
#	1 = max side push
pushSphere.pushSphereStrengthSide		0.25

