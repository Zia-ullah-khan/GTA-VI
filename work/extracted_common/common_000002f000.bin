  <!-- Door Datasets are groups of logically cohesive door datas. Each datasets all feature datas of the same Archetypes, and are streamed within a single PriorityClipsetRequestHelper -->
  <DoorInteractionDataSets>
    <!-- GENERIC_PUSH -->
    <Item key="GENERIC_PUSH_LOCKED_HANDLE_L" type="CDoorInteractionDataSet">
      <Archetypes>Fullbody Generic</Archetypes>
      <PedSpeedData>
        <AuthoredEntrySpeed type="CAISpeed">
          <Mag value="1.800000" />
          <Gait>Gait_Closest</Gait>
          <Type>SpeedType_Velocity</Type>
        </AuthoredEntrySpeed>
        <MinRateScale value="0.7"/>
        <MaxRateScale value="1.3"/>
        <MinEntrySpeed type="CAISpeed">
          <Mag value="-1.000000"/>
        </MinEntrySpeed>
        <MaxEntrySpeed type="CAISpeed">
          <Mag value="2.500000" />
          <Gait>Gait_Closest</Gait>
          <Type>SpeedType_Velocity</Type>
        </MaxEntrySpeed>
        <Flags>SupportsRateScale</Flags>
      </PedSpeedData>
      <PedHeadingData>DEFAULT_WAIT_IN_TASK_HEADING</PedHeadingData>
      <ContactSidePreference>HandleSide</ContactSidePreference>
      <Interactions>
        <Item>GENERIC_PUSH_LOCKED_HANDLE_L_LH</Item>
        <Item>GENERIC_PUSH_LOCKED_HANDLE_L_RH</Item>
      </Interactions>
      <PostAlignInteractions/>
      <OverlayDataSet>OVERLAY_CAUTIOUS_LOOK</OverlayDataSet>
      <DoorType>DOOR_GENERIC</DoorType>
      <StreamingRules>
        <ImportanceRules>
          <Item key="InteractionPossible" type="CDoorInteractionDataStreamingRules">
            <RequiredPedStateFlags>PlayerPed</RequiredPedStateFlags>
            <BannedPedStateFlags/>
            <RequiredDoorStateFlags/>
            <BannedDoorStateFlags>FlaggedToKnock CenteredInteractionPoint</BannedDoorStateFlags>
          </Item>
          <Item key="InteractionLikely" type="CDoorInteractionDataStreamingRules">
            <RequiredPedStateFlags>DoorHandleOnLeftSide</RequiredPedStateFlags>
            <BannedPedStateFlags>Drunk OnFire</BannedPedStateFlags>
            <RequiredDoorStateFlags>Immovable</RequiredDoorStateFlags>
            <BannedDoorStateFlags/>
          </Item>
          <Item key="InteractionRequired" type="CDoorInteractionDataStreamingRules">
            <RequiredPedStateFlags/>
            <BannedPedStateFlags>Crouching</BannedPedStateFlags>
            <RequiredDoorStateFlags/>
            <BannedDoorStateFlags/>
          </Item>
        </ImportanceRules>
      </StreamingRules>
      <SelectionRules>
        <RequiredDataSelectionFlags/>
        <PreferredDataSelectionFlags/>
        <BannedDataSelectionFlags>ApproachingDoubleDoorCenter</BannedDataSelectionFlags>
      </SelectionRules>
    </Item>
    <Item key="GENERIC_PUSH_LOCKED_HANDLE_R" type="CDoorInteractionDataSet" parentPath="../Item[@key='GENERIC_PUSH_LOCKED_HANDLE_L']">
      <Interactions>
        <Item>GENERIC_PUSH_LOCKED_HANDLE_R_LH</Item>
        <Item>GENERIC_PUSH_LOCKED_HANDLE_R_RH</Item>
      </Interactions>
      <StreamingRules>
        <ImportanceRules>
          <Item key="InteractionPossible" type="CDoorInteractionDataStreamingRules">
            <RequiredPedStateFlags>PlayerPed</RequiredPedStateFlags>
            <BannedPedStateFlags/>
            <RequiredDoorStateFlags/>
            <BannedDoorStateFlags>FlaggedToKnock CenteredInteractionPoint</BannedDoorStateFlags>
          </Item>
          <Item key="InteractionLikely" type="CDoorInteractionDataStreamingRules">
            <RequiredPedStateFlags>DoorHandleOnRightSide</RequiredPedStateFlags>
            <BannedPedStateFlags>Drunk OnFire</BannedPedStateFlags>
            <RequiredDoorStateFlags>Immovable</RequiredDoorStateFlags>
            <BannedDoorStateFlags/>
          </Item>
          <Item key="InteractionRequired" type="CDoorInteractionDataStreamingRules">
