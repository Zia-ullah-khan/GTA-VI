es\", \"Disinfecting Evidence / Clean Getaway\", \"Extraction Prep\", \"heist\", fontsize=8.5)\n    draw_arrow(ax, (t1_x + 1.55, 9.2), (t1_x + 1.55, 8.7), color=\"#fde047\")\n    draw_arrow(ax, (t1_x + 1.55, 7.6), (t1_x + 1.55, 7.1), color=\"#fde047\")\n    \n    # Track 2: Equipment & Cell Towers\n    t2_x = 16.1\n    draw_card(ax, t2_x, 9.2, 3.1, 1.1, \"63. Company Property\", \"Steal Heavy Vault Explosives\", \"Breach Gear\", \"heist\", fontsize=8.5)\n    draw_card(ax, t2_x, 7.6, 3.1, 1.1, \"66. Hidden Charges\", \"Rig 3 Regional Cell Towers\", \"Delays Police\", \"heist\", fontsize=8.5)\n    draw_card(ax, t2_x, 6.0, 3.1, 1.1, \"69. Bricked Up\", \"Reinforce Vault Extraction Route\", \"Route Secure\", \"heist\", fontsize=8.5)\n    draw_arrow(ax, (t2_x + 1.55, 9.2), (t2_x + 1.55, 8.7), color=\"#fde047\")\n    draw_arrow(ax, (t2_x + 1.55, 7.6), (t2_x + 1.55, 7.1), color=\"#fde047\")\n    \n    # Track 3: Cartel Intel\n    draw_card(ax, 12.6, 4.4, 3.1, 1.1, \"64. The Missing Link\", \"Interrogate Monty for Vault Codes\", \"Insider Intel\", \"heist\", fontsize=8.5)\n    draw_card(ax, 16.1, 4.4, 3.1, 1.1, \"67. Ride or Die\", \"Acquire Armored Extraction Van\", \"Getaway Vehicle\", \"heist\", fontsize=8.5)\n    draw_arrow(ax, (15.7, 4.95), (16.1, 4.95), color=\"#fde047\")\n    \n    # Scope Out arrows to preps\n    draw_arrow(ax, (8.4 + w, heist_scope_y + 0.6), (t1_x, 9.75), color=\"#fbbf24\", rad=-0.15)\n    draw_arrow(ax, (8.4 + w, heist_scope_y + 0.6), (t2_x, 9.75), color=\"#fbbf24\", rad=-0.25)\n    draw_arrow(ax, (8.4 + w, heist_scope_y + 0.6), (12.6, 4.95), color=\"#fbbf24\", rad=0.15)\n    \n    # Final Heist Execution Card\n    heist_fin_y = 2.0\n    draw_card(ax, 13.5, heist_fin_y, 4.8, 1.3, \"70. THE CARTEL HEIST\", \"Sinfrontera National Bank Vault Raid ($10.5M Take)\", \"MAJOR HEIST CLIMAX\", \"point_of_no_return\", fontsize=9.5)\n    \n    # Convergence arrows to Heist\n    draw_arrow(ax, (t1_x + 1.55, 6.0), (14.5, heist_fin_y + 1.3), color=\"#ef4444\")\n