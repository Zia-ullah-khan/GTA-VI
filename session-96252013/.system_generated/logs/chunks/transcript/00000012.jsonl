gle((x, y), w, h, linewidth=1.0, edgecolor=\"#71717a\", facecolor=\"#ffffff\", zorder=3)\n27:     ax.add_patch(rect)\n28:     \n29:     prefix = \"\"\n30:     if icon_type == \"phone\":\n31:         prefix = \"[CALL] \"\n32:     elif icon_type == \"text\":\n33:    \n<truncated 1652 bytes>\nctangle((x, y), w, h, linewidth=1.4, edgecolor=\"#10b981\", facecolor=\"#064e3b\", zorder=3)\n63:     ax.add_patch(rect)\n64:     ax.text(x + w/2, y + h - 0.22, \"⚡ \" + title, ha=\"center\", va=\"center\", fontsize=font_size+0.6, fontweight=\"bold\", color=\"#34d399\", zorder=4)\n65:     ax.text(x + w/2, y + h/2 - 0.1, note, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#ecfdf5\", zorder=4)\n66: \n67: def draw_arrow(ax, p1, p2, color=\"#ffffff\", lw=1.2, rad=0.0):\n68:     conn = f\"arc3,rad={rad}\" if rad != 0 else \"arc3,rad=0\"\n69:     ax.annotate(\n70:         \"\",\n71:         xy=p2, xytext=p1,\n72:         arrowprops=dict(\n73:             arrowstyle=\"->,head_width=0.28,head_length=0.38\",\n74:             color=color,\n75:             lw=lw,\n76:             shrinkA=3,\n77:             shrinkB=3,\n78:             connectionstyle=conn\n79:         ),\n80:         zorder=2\n81:     )\n82: \n83: # =========================================================================\n84: # 1. RENDER EXACT CHAPTER 1 MATCHING image_1188e9.jpg GROUND TRUTH + SPEEDRUN\n85: # =========================================================================\n86: def render_speedrun_chapter_1():\n87:     fig, ax = plt.subplots(figsize=(25, 28), dpi=200)\n88:     fig.patch.set_facecolor(BG_COLOR)\n89:     ax.set_facecolor(BG_COLOR)\n90:     ax.set_xlim(0, 25)\n91:     ax.set_ylim(0, 28)\n92:     ax.axis(\"off\")\n93:     \n94:     # Title Banner\n95:     ax.text(12.5, 27.4, \"GRAND THEFT AUTO VI — CHAPTER 1 MISSION FLOW (GROUND TRUTH)\", ha=\"center\", va=\"center\", fontsize=17, fontweight=\"bold\", color=\"#ffffff\")\n96:     ax.text(12.5, 26.9, \"Exact 3-Branch Parallel Structure, Decision Diamonds, Mailboxes & Corrected Mission Flow (Missions 1 - 18)\", ha=\"center\", va=\"center\", fontsize=10, color=\"#fde047\")\n97:     \n98:     # Top: PROLOGUE -> GONE FISHING\n99:     mw, mh = 3.6, 0.95\n100:     center_x = 10.8\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
