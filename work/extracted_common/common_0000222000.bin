      <ApproachStyle>Approach_Wide</ApproachStyle>
      <ContinuityStyle>Continuity_Curved</ContinuityStyle>
      <SlowdownStyle>Slowdown_Relaxed</SlowdownStyle>
      <SplineConfig>SplineFollow_Natural</SplineConfig>
      <AvoidanceStyle>Avoidance_Natural</AvoidanceStyle>
      <DoorPathingStyle>Pathing_Natural</DoorPathingStyle>
    </Item>
