f 0x1458dd360 and 0x14407cf00\ntext_end = 0x5f3fe00\nfor tgt in [0x1458dd360, 0x14407cf00]:\n    calls = []\n    for i in range(0, text_end - 5):\n        if exe[i] == 0xe8:\n            rip = raw_to_va(i) + 5\n            disp = struct.unpack_from(\"<i\", exe, i+1)[0]\n            if rip + disp == tgt:\n                calls.append(hex(raw_to_va(i)))\n                if len(calls) >= 25: break\n    print(f\"Callers of 0x{tgt:x}: {calls}\")\n\n# Check callers of sub_1455b2550 or RPF9 TOC decryptor by searching for 0x10000029 or 0x10000001 imm32 in .text\nfor imm in [0x10000001, 0x10000002, 0x10000004, 0x1000000e, 0x10000015, 0x10000029, 0x10000030]:\n    b = struct.pack(\"<I\", imm)\n    pos = 0\n    hits = []\n    while len(hits) < 10:\n        idx = exe.find(b, pos, text_end)\n        if idx < 0: break\n        hits.append(hex(raw_to_va(idx)))\n        pos = idx + 1\n    print(f\"imm32 0x{imm:08x} in .text: {hits}\")\n'@ | python -","WaitMsBeforeAsync":10000,"toolSummary":"Check cipher callers and RPF9 key IDs in .text"}}]}
