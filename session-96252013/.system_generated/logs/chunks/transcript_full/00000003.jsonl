b3_x - 0.4, 11.9))\n    \n    draw_callout(ax, b3_x + mw + 0.4, 11.5, 3.4, 0.75, \"BRIAN'S TEXT\\nSAVE FOR THE FUTURE\", \"text\")\n    draw_arrow(ax, (b3_x + mw, 11.9), (b3_x + mw + 0.4, 11.9))\n    \n    # DOWN TO EARTH\n    draw_mission(ax, b3_x, 9.9, mw, mh, \"DOWN TO EARTH\", \"Marina Smuggling Run\")\n    draw_arrow(ax, (b3_x + mw/2, 11.4), (b3_x + mw/2, 10.85))\n    \n    # Side tasks of Down to Earth\n    draw_callout(ax, b3_x - 3.8, 9.95, 3.4, 0.75, \"DONNIE TEXT\\n($600 IN MAILBOX)\", \"mailbox\")\n    draw_arrow(ax, (b3_x, 10.35), (b3_x - 0.4, 10.35))\n    \n    draw_side(ax, b3_x + mw + 0.4, 9.95, 3.4, 0.85, \"CAL TEXT\\nFind Lost Drugs x4\")\n    draw_arrow(ax, (b3_x + mw, 10.35), (b3_x + mw + 0.4, 10.35))\n    \n    # CLEAR SKIES\n    draw_callout(ax, b3_x, 8.8, mw, 0.65, \"DONNIE'S TEXT\", \"text\")\n    draw_arrow(ax, (b3_x + mw/2, 9.9), (b3_x + mw/2, 9.45))\n    \n    draw_mission(ax, b3_x, 7.4, mw, mh, \"CLEAR SKIES\", \"Deal with Southwind Bikers\")\n    draw_arrow(ax, (b3_x + mw/2, 8.8), (b3_x + mw/2, 8.35))\n    \n    # DAY RELEASE\n    draw_callout(ax, b3_x, 6.3, mw, 0.65, \"LUCIA'S TEXT\", \"text\")\n    draw_arrow(ax, (b3_x + mw/2, 7.4), (b3_x + mw/2, 6.95))\n    \n    draw_mission(ax, b3_x, 4.9, mw, mh, \"DAY RELEASE\", \"Rusty Anchor Bar Night Out\")\n    draw_arrow(ax, (b3_x + mw/2, 6.3), (b3_x + mw/2, 5.85))\n    \n    draw_callout(ax, b3_x + mw + 0.4, 4.95, 3.4, 0.75, \"BUCK ME TEXT\\n(Interest Earned)\", \"cash\")\n    draw_arrow(ax, (b3_x + mw, 5.35), (b3_x + mw + 0.4, 5.35))\n    \n    # Decision Diamond 2: Are Day Release and Just a Scratch both done?\n    dia2_y = 3.6\n    draw_diamond(ax, b3_x + mw/2, dia2_y, 2.2, 0.75, \"Are DAY RELEASE &\\nJUST A SCRATCH done?\")\n    draw_arrow(ax, (b3_x + mw/2, 4.9), (b3_x + mw/2, dia2_y + 0.75))\n    \n    draw_callout(ax, b3_x, 2.2, mw, 0.65, \"YES → BRIAN'S CALL\", \"phone\")\n    draw_arrow(ax, (b3_x + mw/2, dia2_y - 0.75), (b3_x + mw/2, 2.85))\n    \n    draw_mission(ax, b3_x, 0.8, mw, mh, \"SWAMPED\", \"Kingfishers Smugglers Meet\")\n    draw_arrow(ax, (b3_x + mw/2, 2.2), (b3_x + mw/2, 1.75))\n    \n    # -------------------------------------------------------------\n    # THE MISSING REST OF CHAPTER 1 (Right Side: x = 19.5)\n    # -------------------------------------------------------------\n    b4_x = 19.5\n    draw_arrow(ax, (b3_x + mw, 1.25), (b4_x + mw/2, 1.25))\n    draw_callout(ax, b4_x, 0.8, mw, mh, \"BRIAN'S CALL\\n(Donnie's Betrayal)\", \"phone\")\n    \n    draw_arrow(ax, (b4_x + mw/2, 1.75), (b4_x + mw/2, 2.8))\n    draw_mission(ax, b4_x, 2.8, mw, mh, \"DON GONE\", \"Clear Donnie's Trailer\")\n    \n    draw_callout(ax, b4_x, 4.2, mw, 0.65, \"CAL'S CALL (Distress)\", \"phone\")\n    draw_arrow(ax, (b4_x + mw/2, 3.75), (b4_x + mw/2, 4.2))\n    \n    draw_mission(ax, b4_x, 5.3, mw, mh, \"RECALIBRATION\", \"Cal Intervention & Reset\")\n    draw_arrow(ax, (b4_x + mw/2, 4.85), (b4_x + mw/2, 5.3))\n    \n    draw_callout(ax, b4_x, 6.7, mw, 0.65, \"MATTIA'S TEXT (Job Offer)\", \"text\")\n    draw_arrow(ax, (b4_x + mw/2, 6.25), (b4_x + mw/2, 6.7))\n    \n    # TOURIST TRAP\n    draw_mission(ax, b4_x, 7.8, mw, mh, \"TOURIST TRAP\", \"Accept Mattia's Pickup Job\", is_climax=True)\n    draw_arrow(ax, (b4_x + mw/2, 7.35), (b4_x + mw/2, 7.8))\n    \n    draw_speedrun_badge(ax, b4_x + mw + 0.3, 7.6, 2.6, 1.3, \"NO RETURN WARNING\", \"Starting Tourist Trap locks\\nall Chapter 1 side content!\")\n    \n    # HOME SWEET HOME\n    draw_callout(ax, b4_x, 9.2, mw, 0.65, \"KEY LENTO AMBUSH TRIGGER\", \"phone\")\n    draw_arrow(ax, (b4_x + mw/2, 8.75), (b4_x + mw/2, 9.2))\n    \n    draw_mission(ax, b4_x, 10.3, mw, mh, \"HOME SWEET HOME\", \"Defend Key Lento Trailer\")\n    draw_arrow(ax, (b4_x + mw/2, 9.85), (b4_x + mw/2, 10.3))\n    \n    # DISCHARGE TIME\n    draw_callout(ax, b4_x, 11.7, mw, 0.65, \"HOSPITAL AMBULANCE CALL\", \"phone\")\n    draw_arrow(ax, (b4_x + mw/2, 11.25), (b4_x + mw/2, 11.7))\n    \n    draw_mission(ax, b4_x, 12.8, mw, 1.1, \"DISCHARGE TIME\", \"Chapter 1 Climax & Evacuation\", is_climax=True, is_gate=True)\n    draw_arrow(ax, (b4_x + mw/2, 12.35), (b4_x + mw/2, 12.8))\n    \n    # Chapter 2 Transition Box\n    draw_speedrun_badge(ax, b4_x, 14.5, mw, 1.6, \"CHAPTER 2 TRANSITION\", \"Hard cut to Port Gellhorn!\\nMotel arrival & Lucia solo mode.\\nSaves locked permanently.\")\n    draw_arrow(ax, (b4_x + mw/2, 13.9), (b4_x + mw/2, 14.5), color=\"#f43f5e\", lw=2.0)\n    \n    out_path = os.path.join(WORKSPACE_DIR, \"GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\n# =========================================================================\n# 2. RENDER FULL CAMPAIGN SPEEDRUN MASTER FLOWCHART (ALL 5 CHAPTERS)\n# =========================================================================\ndef render_speedrun_master_campaign():\n    fig, ax = plt.subplots(figsize=(32, 20), dpi=200)\n    fig.patch.set_facecolor(BG_COLOR)\n    ax.set_facecolor(BG_COLOR)\n    ax.set_xlim(0, 32)\n    ax.set_ylim(0, 20)\n    ax.axis(\"off\")\n    \n    ax.text(16, 19.3, \"GRAND THEFT AUTO VI — ANY% SPEEDRUN ROUTING MASTER MAP\", ha=\"center\", va=\"center\", fontsize=20, fontweight=\"bold\", color=\"#ffffff\")\n    ax.text(16, 18.7, \"All 5 Story Chapters | Optimal Route, Glitches/Skips, Cash Routing, Time Bypasses & Final Decision Tree\", ha=\"center\", va=\"center\", fontsize=11.5, color=\"#fde047\")\n    \n    col_w = 5.8\n    cols_x = [0.8, 7.0, 13.2, 19.4, 25.6]\n    \n    chapter_headers = [\n        (\"CHAPTER 1: THE KEYS\", \"Missions 1-22 | Parallel Downtime Route\", \"#22d3ee\"),\n        (\"CHAPTER 2: PORT GELLHORN\", \"Missions 23-44 | Character Switch Rush\", \"#f43f5e\"),\n        (\"CHAPTER 3: VICE CITY HEIST\", \"Missions 45-70 | Sinfrontera Bank Preps\", \"#fbbf24\"),\n        (\"CHAPTER 4: AIRPORT TAKEDOWN\", \"Missions 71-95 | $75k Gate & VCIA Heist\", \"#a855f7\"),\n        (\"CHAPTER 5: THE FINALE\", \"Missions 96-102 | Fast 'The Deal' Ending\", \"#ef4444\"),\n    ]\n    \n    for idx, (title, sub, color) in enumerate(chapter_headers):\n        cx = cols_x[idx]\n        panel = patches.Rectangle((cx, 0.6), col_w, 17.6, linewidth=1.8, edgecolor=color, facecolor=\"#26292e\", zorder=1)\n        ax.add_patch(panel)\n        ax.text(cx + col_w/2, 17.8, title, ha=\"center\", va=\"center\", fontsize=11, fontweight=\"bold\", color=color, zorder=2)\n        ax.text(cx + col_w/2, 17.4, sub, ha=\"center\", va=\"center\", fontsize=7.8, color=\"#cbd5e1\", zorder=2)\n        \n    mw = 5.2\n    \n    # ---------------- CHAPTER 1 COLUMN ----------------\n    c1_x = cols_x[0] + 0.3\n    c1_items = [\n        (\"1. Prologue -> 2. Gone Fishing\", \"Grab $140 Mailbox\", \"normal\", 16.2),\n        (\"PARALLEL ROUTE SPLIT\", \"Do NOT sleep 24h on Feng Shui!\", \"badge\", 14.8),\n        (\"Unwanted Attention -> Pipework\", \"Grab $200 Mailbox | Chuck Cooldown\", \"normal\", 13.4),\n        (\"Gear Up -> Just a Scratch\", \"MANDATORY: Joey will block later!\", \"heart\", 12.0),\n        (\"Lab Fees -> Hey Arnold! -> Feng Shui\", \"Grab $600 Mailbox | Unlocks Lucia\", \"normal\", 10.6),\n        (\"SKIP: Haircut / Gifts / Lost Drugs\", \"Saves ~6 minutes in Any%\", \"badge\", 9.2),\n        (\"Coming Home -> Buck Me\", \"Setup Banking App & Deposit\", \"normal\", 7.8),\n        (\"Down to Earth -> Day Release\", \"Smuggling & Night Out\", \"normal\", 6.4),\n        (\"Swamped -> Don Gone\", \"Kingfishers Smugglers Ambush\", \"normal\", 5.0),\n        (\"Recalibration -> Tourist Trap\", \"Point of No Return Trigger\", \"climax\", 3.6),\n        (\"Home Sweet Home -> Discharge Time\", \"Chapter 1 Climax & Evacuation\", \"climax\", 2.0),\n    ]\n    for t, s, ct, cy in c1_items:\n        if ct == \"badge\":\n            draw_speedrun_badge(ax, c1_x, cy, mw, 1.15, t, s, font_size=7.5)\n        elif ct == \"heart\":\n            draw_heart(ax, c1_x, cy, mw, 1.15, t + \"\\n\" + s, skip_label=\"[CRITICAL GATE]\")\n        else:\n            draw_mission(ax, c1_x, cy, mw, 1.15, t, s, is_climax=(ct==\"climax\"))\n            \n    draw_arrow(ax, (c1_x + mw, 2.5), (cols_x[1] + 0.3, 16.5), color=\"#f43f5e\", rad=-0.3, lw=2.0)\n    \n    # ---------------- CHAPTER 2 COLUMN ----------------\n    c2_x = cols_x[1] + 0.3\n    c2_items = [\n        (\"23. What's in the Bag? -> 26. Just Moved In\", \"Starlet Motel Setup & Lucia Solo\", \"normal\", 16.2),\n        (\"28. Moses (Vehicle Fencing)\", \"Quickly register required getaway car\", \"normal\", 14.8),\n        (\"29-37. Port Gellhorn Hustle\", \"Beeline through debt tasks\", \"normal\", 13.4),\n        (\"38. COFFEE BREAK\", \"★ DUAL CHARACTER SWITCHING UNLOCKED ★\\nEnables Fast Character Warping!\", \"badge\", 11.6),\n        (\"39. Hit Avery Pawn\", \"Store Robbery System Active\", \"normal\", 10.0),\n        (\"SKIP: Hit Kingpin Bowling\", \"Bypass secondary non-essential robberies\", \"badge\", 8.6),\n        (\"40-42. Kelly County Operations\", \"Impounded Vehicle recovery\", \"normal\", 7.2),\n        (\"43. Prepare for Vice City\", \"Packing & Asset Liquidation\", \"normal\", 5.8),\n        (\"44. CHECKING OUT\", \"Port Gellhorn Climax -> Move to VC\", \"climax\", 4.0),\n        (\"SPEEDRUN NOTE: CASH ROUTING\", \"Maintain $10,000+ for early VC buys\", \"badge\", 2.2),\n    ]\n    for t, s, ct, cy in c2_items:\n        if ct == \"badge\":\n            draw_speedrun_badge(ax, c2_x, cy, mw, 1.3 if \"SWITCHING\" in t else 1.15, t, s, font_size=7.2)\n        else:\n            draw_mission(ax, c2_x, cy, mw, 1.15, t, s, is_climax=(ct==\"climax\"))\n            \n    draw_arrow(ax, (c2_x + mw, 4.5), (cols_x[2] + 0.3, 16.5), color=\"#fbbf24\", rad=-0.3, lw=2.0)\n    \n    # ---------------- CHAPTER 3 COLUMN ----------------\n    c3_x = cols_x[2] + 0.3\n    c3_items = [\n        (\"45. Welcome to Vice City -> 50. Real Estate\", \"Arrival & First VC Safehouse\", \"normal\", 16.2),\n        (\"51-56.