		<Item key="PAIRED_PED_WANDERING">
			<QualificationCondition type="CAIConditionAnd">
				<Conditions>
					<Condition type="CAIBehaviourConditionArePedsPaired">
						<LeaderPed>PrimaryEntity</LeaderPed>
						<FollowerPed>SecondaryEntity</FollowerPed>
						<AllowRoleSwap value="true"/>
					</Condition>
					<Condition type="CAIConditionReferenced">
						<Name>PED_CAN_TRIGGER_CONVERSATIONS</Name>
					</Condition>
					<Condition type="CAIConditionReferenced">
						<Name>PEDS_ARE_NORMAL_FOR_AMBIENT_CONVO</Name>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionArePedScenarioConfigFlagsSet">
							<Ped>PrimaryEntity</Ped>
							<ConfigFlags>CPED_SCENARIO_CONFIG_FLAG_UsingScenario</ConfigFlags>
						</Condition>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionArePedScenarioConfigFlagsSet">
							<Ped>SecondaryEntity</Ped>
							<ConfigFlags>CPED_SCENARIO_CONFIG_FLAG_UsingScenario</ConfigFlags>
						</Condition>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionIsInPublicTransport"/>
					</Condition>
				</Conditions>
			</QualificationCondition>
