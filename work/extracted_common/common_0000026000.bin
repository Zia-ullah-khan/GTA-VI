		<Item key="PASSING_BY_WANDERING">
			<QualificationCondition type="CAIConditionAnd">
				<Conditions>
					<Condition type="CAIConditionNot">
						<Condition type="CAIBehaviourConditionArePedsPaired">
							<LeaderPed>PrimaryEntity</LeaderPed>
							<FollowerPed>SecondaryEntity</FollowerPed>
							<AllowRoleSwap value="true"/>
						</Condition>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionInSameGroup">
							<GroupTypes>GROUP_FLAG_Ped</GroupTypes>
						</Condition>
					</Condition>
					<Condition type="CAIConditionAngleToTargetRelativeToHeading">
						<FromEntity>PrimaryEntity</FromEntity>
						<TargetEntity>SecondaryEntity</TargetEntity>
						<MinAngleDegrees value="-105.0f"/>
						<MaxAngleDegrees value="105.0f"/>
					</Condition>
					<Condition type="CAIConditionAngleToTargetRelativeToHeading">
						<FromEntity>SecondaryEntity</FromEntity>
						<TargetEntity>PrimaryEntity</TargetEntity>
						<MinAngleDegrees value="-105.0f"/>
						<MaxAngleDegrees value="105.0f"/>
					</Condition>
					<Condition type="CAIConditionNot">
						<Condition type="CAIConditionIsInPublicTransport"/>
					</Condition>
				</Conditions>
			</QualificationCondition>
			<Variations>
				<Item key="POST_DISPUTE">
					<InitiatorCondition type="CAIConditionPedHasSimpleMemoryForPlayer">
						<PlayerPed>TertiaryEntity</PlayerPed>
						<MemoryType>DisputeEscalated</MemoryType>
