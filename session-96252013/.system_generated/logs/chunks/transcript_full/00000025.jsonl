:             \n987:     draw_arrow(ax, (c4_x + mw, 3.1), (cols_x[4] + 0.3, 17.5), color=\"#ef4444\", rad=-0.3, lw=2.0)\n988:     \n989:     # ---------------- CHAPTER 5 COLUMN ----------------\n990:     c5_x = cols_x[4] + 0.3\n991:     c5_items = [\n992:         (\"96. Top of the World -> 98. Scorched Earth\", \"Federal Raid Defense & Cartel Standoff\", \"normal\", 17.2),\n993:         (\"99. Two Hundred Percent\", \"Joint Assault on Mendez Compound\", \"normal\", 15.6),\n994:         (\"100. FINAL DECISION STANDOFF\", \"Choose Loyalty (Ending A) or Immunity (Ending B)\", \"badge\", 13.8),\n995:         (\"★ ENDING B: THE DEAL (ANY% ROUTE) ★\", \"Accept Mendez Deal -> Skip Boat Chase!\\nSAVES 8-12 MINUTES OVER ENDING A!\", \"badge\", 11.4),\n996:         (\"Ending A: Bonnie & Clyde\", \"Loyalty Choice: Fight through Coast Guard.\\nAwards $2,000,000 Payout (NOT a requirement!)\", \"normal\", 9.2),\n997:         (\"Ending C: The Sacrifice\", \"Partner Betrayal -> Solo Escort\", \"normal\", 7.6),\n998:         (\"101. Final Evacuation\", \"Airstrip extraction or border run\", \"climax\", 6.0),\n999:         (\"102. Epilogue & Credits\", \"Credits Roll -> Final IGT Split Time!\", \"badge\", 4.2),\n1000:         (\"TARGET ANY% TIME: ~10h 45m\", \"Assuming optimal dialogue skips and routing\", \"badge\", 2.2),\n1001:     ]\n1002:     for t, s, ct, cy in c5_items:\n1003:         if \"ANY% ROUTE\" in t:\n1004:             draw_speedrun_badge(ax, c5_x, cy, mw, 1.7, t, s, font_size=7.2)\n1005:         elif ct == \"badge\":\n1006:             draw_speedrun_badge(ax, c5_x, cy, mw, 1.3 if \"TARGET\" in t else 1.15, t, s, font_size=7.2)\n1007:         else:\n1008:             draw_mission(ax, c5_x, cy, mw, 1.15, t, s, is_climax=(ct==\"climax\"))\n1009:             \n1010:     out_file = os.path.join(ARTIFACT_DIR, \"flowchart_all_chapters_combined.png\")\n1011:     plt.savefig(out_file, bbox_inches=\"tight\", facecolor=BG_COLOR)\n1012:     plt.close()\n1013:     copy_to_all(\"flo