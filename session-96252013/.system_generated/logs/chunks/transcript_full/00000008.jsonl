{"step_index":336,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-24T23:44:21Z","content":"Created At: 2026-11-24T18:44:21-05:00\nCompleted At: 2026-11-24T18:44:21-05:00\nFile Path: `file:///C:/Users/<user>/.gemini/antigravity-cli/brain/96252013-4633-45e8-b6a2-59b18be9e68c/scratch/build_speedrun_flowcharts.py`\nTotal Lines: 504\nTotal Bytes: 26928\nShowing lines 1 to 160\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import matplotlib.pyplot as plt\n2: import matplotlib.patches as patches\n3: import os\n4: import shutil\n5: \n6: WORKSPACE_DIR = r\"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK\"\n7: ARTIFACT_DIR = r\"C:\\Users\\<user>\\.gemini\\antigravity-cli\\brain\\96252013-4633-45e8-b6a2-59b18be9e68c\"\n8: \n9: BG_COLOR = \"#33363b\"       # Matches GTAVI_MISSION_FLOW1.jpg dark-slate gray\n10: \n11: def draw_mission(ax, x, y, w, h, title, subtitle=\"\", is_climax=False, is_gate=False, font_size=8.5):\n12:     bg = \"#fef08a\" if not is_climax else \"#ffedd5\"\n13:     border = \"#ca8a04\" if not is_climax else \"#ea580c\"\n14:     lw = 2.0 if (is_climax or is_gate) else 1.2\n15:     \n16:     rect = patches.Rectangle((x, y), w, h, linewidth=lw, edgecolor=border, facecolor=bg, zorder=3)\n17:     ax.add_patch(rect)\n18:     \n19:     ty = y + h/2 + 0.12 if subtitle else y + h/2\n20:     ax.text(x + w/2, ty, title, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#1c1917\", zorder=4)\n21:     if subtitle:\n22:         ax.text(x + w/2, y + 0.18, subtitle, ha=\"center\", va=\"center\", fontsize=font_size-1.8, color=\"#44403c\", zorder=4)\n23: \n24: def draw_callout(ax, x, y, w, h, text, icon_type=\"text\", font_size=7.2):\n25:     rect = patches.Rectangle((x, y), w, h, linewidth=1.0, edgecolor=\"#71717a\", facecolor=\"#ffffff\", zorder=3)\n26:     ax.add_patch(rect)\n27:     \n28:     prefix = \"\"\n29:     if icon_type == \"phone\":\n30:         prefix = \"[CALL] \"\n31:     elif icon_type == \"text\":\n32:         prefix = \"[MSG] \"\n33:     elif icon_type == \"mailbox\":\n34:         prefix = \"[MAILBOX] \"\n35:     elif icon_type == \"cash\":\n36:         prefix = \"[$] \"\n37:         \n38:     ax.text(x + w/2, y + h/2, prefix + text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\" if icon_type==\"phone\" else \"normal\", color=\"#09090b\", zorder=4)\n39: \n40: def draw_heart(ax, x, y, w, h, text, skip_label=\"[ANY% SKIP]\", font_size=7.0):\n41:     rect = patches.Rectangle((x, y), w, h, linewidth=1.2, edgecolor=\"#f43f5e\", facecolor=\"#ffe4e6\", zorder=3)\n42:     ax.add_patch(rect)\n43:     t = \"♥ \" + text\n44:     if skip_label:\n45:         t += \"\\n\" + skip_label\n46:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#9f1239\", zorder=4)\n47: \n48: def draw_side(ax, x, y, w, h, text, font_size=7.0):\n49:     rect = patches.Rectangle((x, y), w, h, linewidth=1.2, edgecolor=\"#a855f7\", facecolor=\"#f3e8ff\", zorder=3)\n50:     ax.add_patch(rect)\n51:     t = text + \"\\n[OPTIONAL / SKIP]\"\n52:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#581c87\", zorder=4)\n53: \n54: def draw_diamond(ax, cx, cy, rx, ry, text, font_size=6.8):\n55:     pts = [[cx, cy + ry], [cx + rx, cy], [cx, cy - ry], [cx - rx, cy]]\n56:     poly = patches.Polygon(pts, closed=True, linewidth=1.4, edgecolor=\"#cbd5e1\", facecolor=\"#ffffff\", zorder=3)\n57:     ax.add_patch(poly)\n58:     ax.text(cx, cy, text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#0f172a\", zorder=4)\n59: \n60: def draw_speedrun_badge(ax, x, y, w, h, title, note, font_size=6.8):\n61:     rect = patches.Rectangle((x, y), w, h, linewidth=1.4, edgecolo