y_start - r_idx * gap\n            draw_card(ax, cx, cy, w, h, t, sub, b, ct)\n            if r_idx < len(col) - 1:\n                draw_arrow(ax, (cx + w/2, cy), (cx + w/2, cy - (gap - h)))\n                \n    # Connectors\n    draw_arrow(ax, (cols_x[0] + w, 11.0 - 6*gap + h/2), (cols_x[1], 11.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    draw_arrow(ax, (cols_x[1] + w, 11.0 - 6*gap + h/2), (cols_x[2], 11.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    draw_arrow(ax, (cols_x[2] + w, 11.0 - 6*gap + h/2), (cols_x[3], 11.0 + h/2), color=\"#f43f5e\", rad=-0.25)\n    \n    # Next Chapter Indicator\n    ch5_x, ch5_y = cols_x[3], 11.0 - 4*gap\n    draw_card(ax, ch5_x, ch5_y, w, 0.9, \"→ TRANSITION TO CHAPTER 5\", \"Destination: Endgame (Top of the World, Ma!)\", \"\", \"point_of_no_return\")\n    draw_arrow(ax, (cols_x[3] + w/2, 11.0 - 3*gap), (cols_x[3] + w/2, ch5_y + 0.9), color=\"#ef4444\")\n    \n    out_path = os.path.join(WORKSPACE_DIR, \"flowchart_chapter_4.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\n# ==========================================\n# 5. CHAPTER 5: TOP OF THE WORLD, MA!\n# ==========================================\ndef render_chapter_5():\n    fig, ax = plt.subplots(figsize=(18, 14), dpi=200)\n    fig.patch.set_facecolor(BG_COLOR)\n    ax.set_facecolor(BG_COLOR)\n    ax.set_xlim(0, 18)\n    ax.set_ylim(0, 14)\n    ax.axis(\"off\")\n    \n    setup_header(\n        ax,\n        \"GRAND THEFT AUTO VI — CHAPTER 5: TOP OF THE WORLD, MA!\",\n        \"The Climax, Tactical Assaults, Betrayal, and Branching Endings | Missions 96 - 102\",\n        18,\n        y_top=13.3\n    )\n    \n    w, h = 5.2, 1.2\n    cx = 6.4\n    \n    m_chain = [\n        (\"96. Bird in the Hand\", \"Securing Compromised Informant\", \"\", \"normal\", 12.0),\n        (\"97. Taking Liberties\", \"Raiding Syndicate Evidence Depository\", \"\", \"normal\", 10.5),\n        (\"98. VC Baby\", \"Navigating Vice City Roadblocks\", \"\", \"normal\", 9.0),\n        (\"99. Doggie Bag\", \"Prepping Weapons Cache for Final Strike\", \"\", \"normal\", 7.5),\n        (\"100. OPERATION SAVAGE GLORY\", \"Coast Guard Base Assault & Bridge Demolition\", \"TACTICAL RAID CLIMAX\", \"heist\", 6.0),\n        (\"101. PROTECTIVE CUSTODY\", \"Giorgio's Betrayal, Ambush & 'Proceed' Prompt\", \"FINAL DECISION TRIGGER\", \"point_of_no_return\", 4.3),\n        (\"102. THE END OF THE ROAD\", \"Penthouse Assault, Hard Drive Theft & Keys Escape\", \"CAMPAIGN FINALE\", \"point_of_no_return\", 2.6),\n    ]\n    \n    for t, sub, b, ct, cy in m_chain:\n        draw_card(ax, cx, cy, w, h, t, sub, b, ct, fontsize=10)\n        \n    for i in range(len(m_chain) - 1):\n        cy_cur = m_chain[i][4]\n        cy_next = m_chain[i+1][4]\n        draw_arrow(ax, (cx + w/2, cy_cur), (cx + w/2, cy_next + h), color=\"#ef4444\" if i >= 4 else \"#38bdf8\")\n        \n    # Branching Endings (Level 8)\n    end_y = 0.5\n    ew, eh = 4.8, 1.4\n    \n    # Ending A\n    draw_card(ax, 0.8, end_y, ew, eh, \"ENDING A: BONNIE & CLYDE\", \"Survive together into the Keys\\nReq: 'Hot Together' Status + $2M Banked\", \"CANONICAL RESOLUTION\", \"ending\", fontsize=8.8)\n    draw_arrow(ax, (cx + w/2, 2.6), (0.8 + ew/2, end_y + eh), color=\"#10b981\", rad=-0.25)\n    \n    # Ending B\n    draw_card(ax, 6.6, end_y, ew, eh, \"ENDING B: THE DEAL\", \"Accept Mendez's Immunity Plea\\nSplits Jason & Lucia Under Protection\", \"COMPROMISE ENDING\", \"heist\", fontsize=8.8)\n    draw_arrow(ax, (cx + w/2, 2.6), (6.6 + ew/2, end_y + eh), color=\"#f59e0b\")\n    \n    # Ending C\n    draw_card(ax, 12.4, end_y, ew, eh, \"ENDING C: THE SACRIFICE\", \"Solo Extraction Fallback\\nTragic Partner Separation in the Swamps\", \"TRAGIC RESOLUTION\", \"point_of_no_return\", fontsize=8.8)\n    draw_arrow(ax, (cx + w/2, 2.6), (12.4 + ew/2, end_y + eh), color=\"#ef4444\", rad=0.25)\n    \n    out_path = os.path.join(WORKSPACE_DIR, \"flowchart_chapter_5.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\n# ==========================================\n# 6. COMBINED MASTER FLOWCHART\n# ==========================================\ndef render_combined_master():\n    fig, ax = plt.subplots(figsize=(26, 16), dpi=200)\n    fig.patch.set_facecolor(BG_COLOR)\n    ax.set_facecolor(BG_COLOR)\n    ax.set_xlim(0, 26)\n    ax.set_ylim(0, 16)\n    ax.axis(\"off\")\n    \n    # Master Header\n    ax.text(13, 15.3, \"GRAND THEFT AUTO VI — COMPLETE CAMPAIGN FLOWCHART\", ha=\"center\", va=\"center\", fontsize=18, fontweight=\"bold\", color=\"#ffffff\")\n    ax.text(13, 14.8, \"All 5 Story Chapters | 102 Missions | Milestones, Heists, Points of No Return & Branching Endings\", ha=\"center\", va=\"center\", fontsize=11, color=\"#38bdf8\")\n    \n    # 5 Big Columns for the 5 Chapters\n    cols = [\n        {\"name\": \"CHAPTER 1\", \"sub\": \"Just Like Paradise (Keys)\", \"x\": 0.6, \"w\": 4.6, \"color\": \"#22d3ee\"},\n        {\"name\": \"CHAPTER 2\", \"sub\": \"Paradise Lost (Port Gellhorn)\", \"x\": 5.6, \"w\": 4.6, \"color\": \"#f43f5e\"},\n        {\"name\": \"CHAPTER 3\", \"sub\": \"Tits, Ass, Drug Money (Vice City)\", \"x\": 10.6, \"w\": 4.6, \"color\": \"#fbbf24\"},\n        {\"name\": \"CHAPTER 4\", \"sub\": \"Vice City, Baby (Ocean Beach)\", \"x\": 15.6, \"w\": 4.6, \"color\": \"#a855f7\"},\n        {\"name\": \"CHAPTER 5\", \"sub\": \"Top of the World, Ma! (Climax)\", \"x\": 20.6, \"w\": 4.8, \"color\": \"#ef4444\"},\n    ]\n    \n    for c in cols:\n        box = patches.FancyBboxPatch(\n            (c[\"x\"], 0.4), c[\"w\"], 13.9,\n            boxstyle=\"round,pad=0.03,rounding_size=0.25\",\n            linewidth=1.4,\n            edgecolor=c[\"color\"],\n            facecolor=\"#121722\",\n            zorder=1\n        )\n        ax.add_patch(box)\n        ax.text(c[\"x\"] + c[\"w\"]/2, 14.0, c[\"name\"], ha=\"center\", va=\"center\", fontsi