  <!-- Datas only meant to be used after alignment by some means, either via DoorInteractionData or through GuidedEntry -->
  <DoorInteractionHeadingDatas>
    <Item key="DEFAULT_ENFORCED_HEADING" type="atHashString">
      <HeadingCheckDistance value="1.5f"/>
      <CurrentToDesiredHeadingMismatchTolerenceDegrees value="30.0"/>
      <Flags>UseDoorCenterForHeadingReference RejectDataOnHeadingMismatch</Flags>
    </Item>
    <Item key="DEFAULT_WAIT_IN_TASK_HEADING" type="atHashString">
      <HeadingCheckDistance value="1.5f"/>
      <CurrentToDesiredHeadingMismatchTolerenceDegrees value="30.0"/>
      <Flags>UseDoorCenterForHeadingReference WaitForHeadingInTask</Flags>
    </Item>
    <Item key="NAVIGATE_TO_ACTION_WAIT_IN_TASK_HEADING" type="atHashString">
      <HeadingCheckDistance value="1.5f"/>
      <CurrentToDesiredHeadingMismatchTolerenceDegrees value="15.0"/>
      <Flags>UseClosestPointOnDoorPlaneForHeadingReference WaitForHeadingInTask</Flags>
    </Item>
    <Item key="DOUBLE_DOOR_WAIT_IN_TASK_HEADING" type="atHashString">
      <HeadingCheckDistance value="1.5f"/>
      <CurrentToDesiredHeadingMismatchTolerenceDegrees value="30.0"/>
      <Flags>UseDoorCenterForHeadingReference WaitForHeadingInTask ConsiderDoubleDoorForHeadingReference</Flags>
    </Item>
    <Item key="STATIC_ZONE_FORWARD_HEADING" type="atHashString">
      <CurrentToDesiredHeadingMismatchTolerenceDegrees value="15.0"/>
      <Flags>UseClosestPointOnDoorPlaneForHeadingReference</Flags>
    </Item>
  </DoorInteractionHeadingDatas>

  <!-- Determines when the door interaction can break out with respect to various inputs -->
  <DoorInteractionBreakoutDatas>
    <Item key="MOVING_THROUGH_DOOR_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <PostOpenMinBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorwayNormal</ReferenceDirectionType>
      <Flags/>
    </Item>
    <Item key="MOVING_THROUGH_DOOR_HOLD_FOR_PERFORMANCE_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <PostOpenMinBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorwayNormal</ReferenceDirectionType>
      <Flags>DontApplyPostOpenBreakoutAngleUntilInteractionFinished</Flags>
    </Item>
    <Item key="DOOR_ATTEMPT_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorwayNormal</ReferenceDirectionType>
      <Flags/>
    </Item>
    <Item key="DOOR_BREACH_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorNormal</ReferenceDirectionType>
      <Flags/>
    </Item>
    <Item key="DOOR_BREACH_ATTEMPT_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorNormal</ReferenceDirectionType>
      <Flags>BlockBreakoutOnStickRelease</Flags>
    </Item>
    <Item key="NAVIGATE_TO_ACTION_BREAKOUT_DATA" type="atHashString">
      <MaxBreakoutAngleDegrees value="90.f"/>
      <MinBreakoutAngleDegrees value="60.f"/>
      <InitialMovementDirectionBreakoutAngleDegrees value="22.5f"/>
      <ReferenceDirectionType>DoorwayNormal</ReferenceDirectionType>
      <Flags>BlockBreakoutOnStickRelease</Flags>
    </Item>
  </DoorInteractionBreakoutDatas>

  <!-- Determines when the door interaction can break out with respect to various inputs -->
  <DoorInteractionBodyBlendOutDatas>
    <Item key="DEFAULT_INTERRUPT_TO_IDLE_BLENDOUT_DATA" type="atHashString">
      <WeightMode>Template</WeightMode>
      <Template>template_INTERACTION_DOOR_Interrupt_To_Idle</Template>
      <SwapInputs value="false"/>
      <ExternalDofsFilter>TaskEntityInteraction_BodyBlendOut_filter</ExternalDofsFilter>
    </Item>
  </DoorInteractionBodyBlendOutDatas>

  <!-- Allows specifying MTH weights for fullbody alignment anims -->
  <DoorInteractionMTHDatas>
    <Item key="DEFAULT_MTH_WEIGHTS" type="CDoorInteractionMTHData">
      <WeightOverrides>
        <Weights>
          <Item>
            <WeightType>PositionOffset</WeightType>
            <Weight value="1.000000" />
          </Item>
          <Item>
            <WeightType>PositionOffsetDistanceToLine</WeightType>
            <Weight value="0.500000" />
          </Item>
          <Item>
            <WeightType>HeadingOffset</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>PositionOffsetDistanceToTarget</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>CyclePhase</WeightType>
            <Weight value="0.250000" />
          </Item>
        </Weights>
      </WeightOverrides>
    </Item>
    <Item key="NEAR_DOOR_MTH_WEIGHTS" type="CDoorInteractionMTHData">
      <WeightOverrides>
        <Weights>
          <Item>
            <WeightType>PositionOffset</WeightType>
            <Weight value="5.000000" />
          </Item>
          <Item>
            <WeightType>HeadingOffset</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>PositionOffsetDistanceToTarget</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>CyclePhase</WeightType>
            <Weight value="0.100000" />
          </Item>
        </Weights>
      </WeightOverrides>
    </Item>
    <Item key="DOOR_BREACH_MTH_WEIGHTS" type="CDoorInteractionMTHData">
      <WeightOverrides>
        <Weights>
          <Item>
            <WeightType>PositionOffset</WeightType>
            <Weight value="1.000000" />
          </Item>
          <Item>
            <WeightType>PositionOffsetDistanceToLine</WeightType>
            <Weight value="0.500000" />
          </Item>
          <Item>
            <WeightType>HeadingOffset</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>PositionOffsetDistanceToTarget</WeightType>
            <Weight value="0.000000" />
          </Item>
          <Item>
            <WeightType>CyclePhase</WeightType>
            <Weight value="0.250000" />
          </Item>
        </Weights>
      </WeightOverrides>
      <PredictiveEvaluationSampleThresholdScore value="0.1"/>
      <Flags>AllowPredictiveEvaluation</Flags>
    </Item>

  </DoorInteractionMTHDatas>

