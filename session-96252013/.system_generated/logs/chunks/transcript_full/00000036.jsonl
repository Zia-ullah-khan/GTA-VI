to t_raw\nfor opcode in [b'\\x8d\\x05', b'\\x8d\\x0d', b'\\x8d\\x15', b'\\x8d\\x1d', b'\\x8d\\x25', b'\\x8d\\x2d', b'\\x8d\\x35', b'\\x8d\\x3d']:\n    p = pos\n    while True:\n        idx = data.find(opcode, p, end)\n        if idx == -1: break\n        rel = struct.unpack_from('<i', data, idx + 2)[0]\n        if idx + 6 + rel == t_raw:\n            lea_hits.append(hex(idx + 0x140000000 + 0xc00))\n        p = idx + 1\nprint('LEA refs to 0x1443b0d00:', lea_hits)\n\n# Also check if 0x1443b0d00 is in .pdata and what its callers/deserializers look like at 0x144083680..0x144083c00\nprint('=== 0x1409dfd80 (inside PSIN parser) ===')\nr = va_to_raw(0x1409dfd80)\nfor insn in md.disasm(data[r:r+300], 0x1409dfd80):\n    print(f'  {hex(insn.address)}: {insn.mnemonic} {insn.op_str}')\n\nprint('=== 0x144082b00..0x144082d00 (LSNS deserializer?) ===')\n# search for 0x534e534c ('LSNS') in .text!\np = pos\nlsns_refs = []\nwhile True:\n    idx = data.find(b'LSNS', p, end)\n    if idx == -1: break\n    lsns_refs.append(hex(idx + 0x140000000 + 0xc00))\n    p = idx + 1\nprint('LSNS imm32 in .text:', lsns_refs)\nfor b_magic in [b'LENM', b'LGID', b'LRSC', b'LSCH', b'0DRP']:\n    p = pos\n    hits = []\n    while True:\n        idx = data.find(b_magic, p, end)\n        if idx == -1: break\n        hits.append(hex(idx + 0x140000000 + 0xc00))\n        p = idx + 1\n    print(b_magic.decode(), 'imm32 in .text:', hits)\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Find LSNS/PSIN/XXTEA references in exe"}}]}
