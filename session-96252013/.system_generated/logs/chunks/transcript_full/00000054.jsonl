w(ax, (sk_x + sk_w/2, 4.45), (sk_x + sk_w/2, 4.15), color=\"#a855f7\")\n432:     \n433:     draw_mission(ax, sk_x, 3.1, sk_w, mh, \"17. DON GONE [COM_KBOS_CLEAN]\", \"Clean Donnie's Trailer | Jason\\n[ANY% SKIP / AUTO-FLAGGED]\", is_skip=True, font_size=7.6)\n434:     \n435:     draw_mission(ax, sk_x, 1.4, sk_w, mh, \"18. RECALIBRATION [HO_PAR_KEYCO]\", \"Cal Grief Fishing | Jason & Lucia\\n[ANY% SKIP / AUTO-FLAGGED]\", is_skip=True, font_size=7.6)\n436:     draw_arrow(ax, (sk_x + sk_w/2, 3.1), (sk_x + sk_w/2, 2.45), color=\"#a855f7\")\n437:     \n438:     # -------------------------------------------------------------\n439:     # MAIN STORY MANDATORY GAUNTLET:\n440:     # 19. TOURIST TRAP -> 20. HOME SWEET HOME -> 21. DISCHARGE TIME\n441:     # -------------------------------------------------------------\n442:     sp_x = 5.0\n443:     sp_w = 4.8\n444:     \n445:     # Arrow from Swamped to Tourist Trap\n446:     draw_arrow(ax, (dia2_x, sw_exit_y), (sp_x + sp_w/2, 4.25))\n447:     \n448:     draw_mission(ax, sp_x, 3.1, sp_w, mh, \"19. TOURIST TRAP [BIL_PICK]\", \"Grassrivers Visitor Center Locker Pickup\\n[10:00–17:00 / 17:00–10:00] | Jason Shot!\", font_size=7.8)\n449:     \n450:     draw_mission(ax, sp_x, 1.4, sp_w, mh, \"20. HOME SWEET HOME [BIL_HOUSE]\", \"Lucia Hamlet Stash Retrieval | Lucia Solo\\nCartel Hitmen Ambush — House Torched!\", font_size=7.8)\n451:     draw_arrow(ax, (sp_x + sp_w/2, 3.1), (sp_x + sp_w/2, 2.45))\n452:     \n453:     # 21. DISCHARGE TIME (Chapter 1 Finale Climax)\n454:     clim_x = 10.4\n455:     clim_w = 5.2\n456:     clim_h = 1.35\n457:     draw_mission(ax, clim_x, 1.25, clim_w, clim_h, \"21. DISCHARGE TIME [BIL_WHEEL]\", \"★ CHAPTER 1 FINALE CLIMAX ★\\nVice City Hospital Shootout & Ambulance Escape!\\nLucia Rescues Jason — Flee West to Kelly County!\", is_climax=True, is_gate=True, font_size=8.0)\n458:     \n459:     draw_arrow(ax, (sp_x + sp_w, 1.9), (clim_x, 1.9), color=\"#ea580c\", lw=1.8)\n460:     \n461:     # CHAPTER 2 TRANSITION BADGE\n462:     trans_x = 16.2\n463:     trans_w = 9.2\n464:     trans_h = 2.1\n465:     draw_speedrun_badge(\n466:         ax, trans_x, 0.9, trans_w, trans_h,\n467:         \"CHAPTER 2 TRANSITION: WHAT'S IN THE BAG? [MTL_WAKE]\",\n468:         \"Hard cut to Starlet Motel (Port Gellhorn)!\\nfunc_10AA55 sweeps & auto-flags all 7 uncompleted side missions:\\n• Lab Fees [0x2D7D2164] • Unwanted Attention [0x5AE70594]\\n• Pipework [0xC8513199] • Hey Arnold! [0x21D03E4F]\\n• Don Gone [0x10BE4C94] • Recalibration [0x420623AF] • Island Dreams\",\n469:         font_size=6.6\n470:     )\n471:     draw_arrow(ax, (clim_x + clim_w, 1.9), (trans_x, 1.9), color=\"#f43f5e\", lw=2.2)\n472:     \n473:     out_file1 = os.path.join(ARTIFACT_DIR, \"flowchart_chapter_1.png\")\n474:     plt.savefig(out_file1, bbox_inches=\"tight\", facecolor=BG_COLOR)\n475:     \n476:     out_file2 = os.path.join(ARTIFACT_DIR, \"GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png\")\n477:     plt.savefig(out_file2, bbox_inches=\"tight\", facecolor=BG_COLOR)\n478:     plt.close()\n479:     \n480:     copy_to_all(\"flowchart_chapter_1.png\")\n481:     copy_to_all(\"GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png\")\n482:     print(\"Rendered Chapter 1 (flowchart_chapter_1.png & GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.png).\")\n483: \n484: # =========================================================================\n485: # 2. CHAPTER 2: PORT GELLHORN & KELLY COUNTY (CLASSIC DESIGN)\n486: # =========================================================================\n487: def render_chapter_2():\n488:     fig, ax = plt.subplots(figsize=(25, 13), dpi=200)\n489:     fig.patch.set_facecolor(BG_COLOR)\n490:     ax.set_facecolor(BG_COLOR)\n491:     ax.set_xlim(0, 25)\n492:     ax.set_ylim(3.2, 16.0)\n493:     ax.axis(\"off\")\n494:     \n495:     setup_header(\n496:         ax,\n497:         \"GRAND THEFT AUTO VI — CHAPTER 2: PARADISE LOST\",\n498:         \"Setting: Port Gellhorn & Kelly County | Missions 23 - 44 | Dual Character Switching Unlocked\",\n499:         25,\n500:         y_top=15.4\n501:     )\n502:     \n503:     w, h = 4.6, 1.0\n504:     cols_x = [1.0, 7.2, 13.4, 19.4]\n505:     gap = 1.32\n506:     \n507:     # STAGE 1: MOTEL ARRIVAL & MEDICAL (Missions 23 - 28)\n508:     s1_cards = [\n509:         (\"23. What's in the Bag?\", \"Starlet Motel Arrival & Safehouse\", False),\n510:         (\"24. Overnight Charges\", \"Paying Motel Upkeep & Debts\", False),\n511:         (\"25. Take Care of Jason\", \"Lucia Solo Medical Supply Run\", False),\n512:         (\"26. Just Moved In\", \"Setting Up Port Gellhorn Base\", False),\n513:         (\"27. Girls' Trip\", \"Local Contact Introduction\", False),\n514:         (\"28. Moses\", \"Vehicle Fencing & Chop Shop Access\", False),\n515:     ]\n516:     \n517:     # STAGE 2: DEBT HUSTLE & GUN RUNS (Missions 29 - 37)\n518:     s2_cards = [\n519:         (\"29. New Look -> 30. How Do I Look?\", \"Disguise and Wardrobe Setup\", False),\n520:         (\"31. Behind on Payments\", \"Collecting Local Debt\", False),\n521:         (\"32. Ambulance Chaser\", \"Medical Fraud Operation\", False),\n522:         (\"33. Painkiller Supplier\", \"Securing Prescription Drugs\", False),\n523:         (\"34. Daily Driver -> 35. Pick Up A Gun\", \"Securing Getaway Wheels & Firearm\", False),\n524:         (\"36. Slam Dunk -> 37. Breakfast Run\", \"Local Corner Job & Meetup\", False),\n525:     ]\n526:     \n527:     # STAGE 3: COFFEE BREAK & PAWN SHOP ROBBERIES (Missions 38 - 40)\n528:     s3_cards = [\n529:         (\"38. Coffee Break\", \"★ DUAL CHARACTER SWITCHING UNLOCKED ★\\nEnables Fast Character Warping!\", True), # milestone\n530:         (\"39. Hit Avery Pawn\", \"Store Robbery System Active\", False),\n531:         (\"40. Hit Kingpin Bowling\", \"Kelly County Robbery Operation\\n[Optional / Any% Skip]\", False),\n532:     ]\n533:     \n534:     # STAGE 4: HIGHWAY ESCAPE & MOVE TO VICE CITY (Missions 41 - 44)\n535:     s4_cards = [\n536:         (\"41. Impounded Vehicle\", \"Retrieving Confiscated Ride\", False),\n537:         (\"42. Afternoon Delight\", \"Kelly County Smugglers Meet\", False),\n538:         (\"43. Prepare for Vice City\", \"Liquidating Local Assets & Packing\", False),\n539:         (\"44. Checking Out\", \"Port Gellhorn Climax & Motel Shootout\", True), # climax\n540:     ]\n541:     \n542:     stages = [\n543:         (\"STAGE 1: MOTEL ARRIVAL (M23-28)\", s1_cards, cols_x[0]),\n544:         (\"STAGE 2: DEBT HUSTLE (M29-37)\", s2_cards, cols_x[1]),\n545:         (\"STAGE 3: DUAL SWITCHING (M38-40)\", s3_cards, cols_x[2]),\n546:         (\"STAGE 4: MOVE TO VC (M41-44)\", s4_cards, cols_x[3]),\n547:     ]\n548:     \n549:     for s_idx, (stitle, card_list, cx) in enumerate(stages):\n550:         hdr_rect = patches.FancyBboxPatch(\n551:             (cx, 14.0), w, 0.65,\n552:             boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n553:             linewidth=1.2,\n554:             edgecolor=\"#ca8a04\",\n555:             facecolor=\"#26292e\",\n556:             zorder=3\n557:         )\n558:         ax.add_patch(hdr_rect)\n559:         ax.text(cx + w/2, 14.32, stitle, ha=\"center\", va=\"center\", fontsize=8.8, fontweight=\"bold\", color=\"#fde047\", zorder=4)\n560:         \n561:         y_start = 12.5\n562:         for r_idx, (t, sub, is_spec) in enumerate(card_list):\n563:             cy = y_start - r_idx * gap\n564:             if \"SWITCHING\" in sub:\n565:                 draw_speedrun_badge(ax, cx, cy, w, h + 0.25, t, sub, font_size=7.5)\n566:             elif \"Optional\" in sub:\n567:                 draw_side(ax, cx, cy, w, h, t, font_size=7.5)\n568:             else:\n569:                 draw_mission(ax, cx, cy, w, h, t, sub, is_climax=is_spec, font_size=8.2)\n570:                 \n571:             if r_idx < len(card_list) - 1:\n572:                 draw_arrow(ax, (cx + w/2, cy), (cx + w/2, cy - (gap - h)))\n573:                 \n574:     # Gutter Bridges connecting sequential stages\n575:     gx1 = (cols_x[0] + w + cols_x[1]) / 2\n576:     draw_stage_bridge(ax, cols_x[0] + w/2, 12.5 - 5*gap, cols_x[1], 12.5 + h/2, gx1, \"STAGE 2 ▲\\nNEXT\")\n577:     \n578:     gx2 = (cols_x[1] + w + cols_x[2]) / 2\n579:     draw_stage_bridge(ax, cols_x[1] + w/2, 12.5 - 5*gap, cols_x[2], 12.5 + h/2, gx2, \"STAGE 3 ▲\\nNEXT\")\n580:     \n581:     gx3 = (cols_x[2] + w + cols_x[3]) / 2\n582:     draw_stage_bridge(ax, cols_x[2] + w/2, 12.5 - 2*gap, cols_x[3], 12.5 + h/2, gx3, \"STAGE 4 ▲\\nNEXT\")\n583:     \n584:     # Transition to Chapter 3 Badge\n585:     ch3_y = 12.5 - 4.5*gap\n586:     draw_speedrun_badge(ax, cols_x[3], ch3_y, w, 1.25, \"CHAPTER 3 TRANSITION\", \"Hard cut to Vice City!\\nMove to First South Leonida Safehouse.\")\n587:     draw_arrow(ax, (cols_x[3] + w/2, 12.5 - 3*gap), (cols_x[3] + w/2, ch3_y + 1.25), color=\"#f43f5e\", lw=2.0)\n588:     \n589:     out_file = os.path.join(ARTIFACT_DIR, \"flowchart_chapter_2.png\")\n590:     plt.savefig(out_file, bbox_inches=\"tight\", facecolor=BG_COLOR)\n591:     plt.close()\n592:     copy_to_all(\"flowchart_chapter_2.png\")\n593:     print(\"Rendered Chapter 2 (Classic Design).\")\n594: \n595: # =========================================================================\n596: # 3. CHAPTER 3: VICE CITY SYNDICATE EXPANSION (CLASSIC DESIGN)\n597: # =========================================================================\n598: def render_chapter_3():\n599:     fig, ax = plt.subplots(figsize=(26, 16), dpi=200)\n600:     fig.patch.set_facecolor(BG_COLOR)\n601:     ax.set_facecolor(BG_COLOR)\n602:     ax.set_xlim(0, 26)\n603:     ax.set_ylim(0, 16)\n604:     ax.axis(\"off\")\n605:     \n606:     setup_header(\n607:         ax,\n608:         \"GRAND THEFT AUTO VI — CHAPTER 3: VICE CITY SYNDICATE EXPANSION\",\n609:         \"Setting: Vice City Metro | Missions 45 - 70 | 3 Parallel Strands -> Sinfrontera Heist Preps\",\n610:         26,\n611:         y_top=15.3\n612:     )\n613:     \n614:     w, h = 3.6, 1.05\n615:     \n6