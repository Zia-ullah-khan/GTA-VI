RED\": \"Epilogue & Credits (Leonida Free Roam Restored)\"\n}\n\norder_file = r\"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK\\output\\mission_order.json\"\nwith open(order_file, \"r\", encoding=\"utf-8\") as f:\n    d = json.load(f)\n\nupdated_count = 0\nfor m in d[\"missions\"]:\n    mid = m[\"id\"]\n    if mid in mission_title_map:\n        m[\"display_name\"] = mission_title_map[mid]\n        updated_count += 1\n\nprint(f\"Updated {updated_count} missions in mission_order.json with display_name.\")\n\nfor item in d[\"cmissions_entries_not_in_replay_menu\"]:\n    mid = item[\"id\"]\n    if mid in mission_title_map:\n        item[\"display_name\"] = mission_title_map[mid]\n\nwith open(order_file, \"w\", encoding=\"utf-8\") as f:\n    json.dump(d, f, indent=2)\n\nprint(\"Saved updated mission_order.json.\")\n","Description":"Update mission_order.json with full human-readable titles","Overwrite":true,"TargetFile":"C:\\Users\\<user>\\.gemini\\antigravity-cli\\brain\\96252013-4633-45e8-b6a2-59b18be9e68c\\scratch\\populate_mission_titles.py","toolAction":"Writing title population script","toolSummary":"Populate display_name in mission_order.json"}}]}
