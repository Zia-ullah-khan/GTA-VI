stem Active\", \"Robberies\", \"milestone\", 7.8),\n        (\"40-43. Kelly County Operations\", \"Impounded Vehicle -> Prepare\", \"\", \"normal\", 6.5),\n        (\"44. Checking Out\", \"Depart Port Gellhorn for VC\", \"Ch. 2 End\", \"point_of_no_return\", 5.2),\n    ]\n    for t, sub, b, ct, cy in ch2_nodes:\n        draw_card(ax, cols[1][\"x\"] + 0.2, cy, cw, 1.05, t, sub, b, ct, fontsize=8)\n    for i in range(len(ch2_nodes) - 1):\n        draw_arrow(ax, (cols[1][\"x\"] + 0.2 + cw/2, ch2_nodes[i][4]), (cols[1][\"x\"] + 0.2 + cw/2, ch2_nodes[i+1][4] + 1.05))\n        \n    # Ch 2 to Ch 3 connector\n    draw_arrow(ax, (cols[1][\"x\"] + 0.2 + cw, 5.2 + 0.52), (cols[2][\"x\"] + 0.2, 13.0 + 0.52), color=\"#fbbf24\", rad=-0.25, lw=2.2)\n    \n    # Chapter 3 Summary Nodes\n    ch3_nodes = [\n        (\"45. Welcome to Vice City\", \"Arrival in the Metropolis\", \"\", \"normal\", 13.0),\n        (\"46-54. Establishing Syndicate\", \"Meet Heders -> Top Billing\", \"\", \"normal\", 11.8),\n        (\"55-56. Major Alliances\", \"Boobie Ike & Raul Bautista\", \"Cartel Allies\", \"milestone\", 10.5),\n        (\"61. Sinfrontera Bank Scope\", \"Planning the Vault Score\", \"Heist Plan\", \"heist\", 9.2),\n        (\"62-69. Heist Preps (5 Tasks)\", \"Nicole Park, Cell Towers, Intel\", \"5 Prep Jobs\", \"heist\", 7.6),\n        (\"70. THE CARTEL HEIST\", \"Sinfrontera Vault Score ($10.5M)\", \"HEIST CLIMAX\", \"point_of_no_return\", 5.5),\n    ]\n    for t, sub, b, ct, cy in ch3_nodes:\n        draw_card(ax, cols[2][\"x\"] + 0.2, cy, cw, 1.1, t, sub, b, ct, fontsize=8)\n    for i in range(len(ch3_nodes) - 1):\n        draw_arrow(ax, (cols[2][\"x\"] + 0.2 + cw/2, ch3_nodes[i][4]), (cols[2][\"x\"] + 0.2 + cw/2, ch3_nodes[i+1][4] + 1.1))\n        \n    # Ch 3 to Ch 4 connector\n    draw_arrow(ax, (cols[2][\"x\"] + 0.2 + cw, 5.5 + 0.55), (cols[3][\"x\"] + 0.2, 13.0 + 0.55), color=\"#a855f7\", rad=-0.25, lw=2.2)\n    \n    # Chapter 4 Summary Nodes\n    ch4_nodes = [\n        (\"71. Ocean Beach\", \"Establish Y Hotel Safehouse\", \"Safehouse\", \"milestone\", 13.0),\n        (\"75. Party Hard\", \"$75k Wire to Abe Gonzalez\", \"Cash Gate\", \"milestone\", 11.7),\n        (\"76-87. Corporate & Syndicate\", \"Dirty Work -> Power Play\", \"\", \"normal\", 10.4),\n        (\"88. Headliners\", \"Dre'Quan Climax Performance\", \"Dre'Quan End\", \"milestone\", 9.1),\n        (\"89-92. VCIA Airport Preps\", \"Fully Catered & Perimeter Recon\", \"Airport Preps\", \"heist\", 7.8),\n        (\"93. VCIA TAKEDOWN\", \"Major Airport Cargo Robbery\", \"AIRPORT HEIST\", \"heist\", 6.5),\n        (\"94. Sunset\", \"Open-World Lockdown\", \"★ NO RETURN ★\", \"point_of_no_return\", 5.2),\n        (\"95. Starting From Zero\", \"Transition to Final Stage\", \"Ch. 4 End\", \"point_of_no_return\", 4.0),\n    ]\n    for t, sub, b, ct, cy in ch4_nodes:\n        draw_card(ax, cols[3][\"x\"] + 0.2, cy, cw, 1.0, t, sub, b, ct, fontsize=8)\n    for i in range(len(ch4_nodes) - 1):\n        draw_arrow(ax, (cols[3][\"x\"] + 0.2 + cw/2, ch4_nodes[i][4]), (cols[3][\"x\"] + 0.2 + cw/2, ch4_nodes[i+1][4] + 1.0))\n        \n    # Ch 4 to Ch 5 connector\n    draw_arrow(ax, (cols[3][\"x\"] + 0.2 + cw, 4.0 + 0.5), (cols[4][\"x\"] + 0.2, 13.0 + 0.5), color=\"#ef4444\", rad=-0.25, lw=2.2)\n    \n    # Chapter 5 Summary Nodes\n    ch5_nodes = [\n        (\"96-99. Endgame Setup\", \"Taking Liberties -> Doggie Bag\", \"\", \"normal\", 13.0),\n        (\"100. OP. SAVAGE GLORY\", \"Coast Guard Base & Bridge Raid\", \"TACTICAL RAID\", \"heist\", 11.5),\n        (\"101. PROTECTIVE CUSTODY\", \"Giorgio's Ambush & Proceed Prompt\", \"FINAL TRIGGER\", \"point_of_no_return\", 9.8),\n        (\"102. THE END OF THE ROAD\", \"Penthouse Assault & Keys Escape\", \"FINAL MISSION\", \"point_of_no_return\", 8.0),\n    ]\n    for t, sub, b, ct, cy in ch5_nodes:\n        draw_card(ax, cols[4][\"x\"] + 0.2, cy, cw, 1.15, t, sub, b, ct, fontsize=8)\n    for i in range(len(ch5_nodes) - 1):\n        draw_arrow(ax, (cols[4][\"x\"] + 0.2 + cw/2, ch5_nodes[i][4]), (cols[4][\"x\"] + 0.2 + cw/2, ch5_nodes[i+1][4] + 1.15))\n        \n    # 3 Endings inside Ch 5 column\n    ew, eh = 4.2, 1.1\n    # Ending A\n    draw_card(ax, cols[4][\"x\"] + 0.2, 5.8, ew, eh, \"ENDING A: BONNIE & CLYDE\", \"Survive Together in the Keys\\nReq: 'Hot Together' + $2M Savings\", \"CANONICAL\", \"ending\", fontsize=7.8)\n    draw_arrow(ax, (cols[4][\"x\"] + 0.2 + ew/2, 8.0), (cols[4][\"x\"] + 0.2 + ew/2, 5.8 + eh), color=\"#10b981\")\n    \n    # Ending B\n    draw_card(ax, cols[4][\"x\"] + 0.2, 4.2, ew, eh, \"ENDING B: THE DEAL\", \"Accept Mendez's Immunity Plea\\nProtective Custody Separation\", \"COMPROMISE\", \"heist\", fontsize=7.8)\n    draw_arrow(ax, (cols[4][\"x\"] + 0.2 + ew/2, 8.0), (cols[4][\"x\"] + 0.2 + ew/2, 4.2 + eh), color=\"#f59e0b\", rad=0.25)\n    \n    # Ending C\n    draw_card(ax, cols[4][\"x\"] + 0.2, 2.6, ew, eh, \"ENDING C: THE SACRIFICE\", \"Solo Swamp Extraction Fallback\\nTragic Partner Separation\", \"TRAGIC\", \"point_of_no_return\", fontsize=7.8)\n    draw_arrow(ax, (cols[4][\"x\"] + 0.2 + ew/2, 8.0), (cols[4][\"x\"] + 0.2 + ew/2, 2.6 + eh), color=\"#ef4444\", rad=-0.25)\n    \n    # Legend at the bottom across columns 1-4\n    leg_x = 0.8\n    leg_y = 0.6\n    leg_items = [\n        (\"Normal Story Mission\", \"normal\"),\n        (\"Key Milestone / Unlocks\", \"milestone\"),\n        (\"Major Heist / Preparation\", \"heist\"),\n        (\"Point of No Return / Climax\", \"point_of_no_return\"),\n        (\"Branching Story Ending\", \"ending\"),\n    ]\n    for i, (label, ctype) in enumerate(leg_items):\n        lx = leg_x + i * 3.8\n        st = STYLES[ctype]\n        r = patches.FancyBboxPatch((lx, leg_y), 3.4, 0.5, boxstyle=\"round,pad=0.02,rounding_size=0.1\", lw=1.2, edgecolor=st[\"border\"], facecolor=st[\"bg\"])\n        ax.add_patch(r)\n        ax.text(lx + 1.7, leg_y + 0.25, label, ha=\"center\", va=\"center\", fontsize=8, fontweight=\"bold\", color=st[\"title\"])\n        \n    out_path = os.path.join(WORKSPACE_DIR, \"flowchart_all_chapters_combined.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)\n\nif __name__ == \"__main__\":\n    print(\"Generating Chapter 1...\")\n    render_chapter_1()\n    print(\"Generatin