{"step_index":714,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-25T01:46:29Z","content":"Created At: 2026-11-24T20:46:29-05:00\nCompleted At: 2026-11-24T20:46:29-05:00\nFile Path: `file:///C:/Users/<user>/Downloads/GTA6.Xbox.v1.0.2.1-CYBERLEEK/work/title_probe.py`\nTotal Lines: 80\nTotal Bytes: 2763\nShowing lines 1 to 80\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"Search extracted payloads for candidate mission titles as ASCII and UTF-16LE, case-insensitively.\"\"\"\r\n2: \r\n3: import argparse\r\n4: import re\r\n5: import sys\r\n6: from collections import defaultdict\r\n7: from pathlib import Path\r\n8: \r\n9: QUOTED_TITLE = re.compile(r\"\\*\\\"?([A-Z][^*\\\"\\n]{3,40}?)\\\"?\\*\")\r\n10: NUMBERED_TITLE = re.compile(r\"\\\"\\d+\\.\\s+([^<\\\"(]{4,40}?)(?:<br/>|\\\"|\\s*\\()\")\r\n11: MIN_TITLE_LENGTH = 8\r\n12: \r\n13: \r\n14: def collect_titles(chart_path: Path) -> list[str]:\r\n15:     text = chart_path.read_text(encoding=\"utf-8\")\r\n16:     titles = set()\r\n17:     for pattern in (QUOTED_TITLE, NUMBERED_TITLE):\r\n18:         for match in pattern.findall(text):\r\n19:             title = match.strip()\r\n20:             if len(title) >= MIN_TITLE_LENGTH and \" \" in title:\r\n21:                 titles.add(title)\r\n22: \r\n23:     return sorted(titles)\r\n24: \r\n25: \r\n26: def encodings(title: str) -> list[bytes]:\r\n27:     variants = {title, title.upper(), title.lower(), title.replace(\"'\", \"\\u2019\")}\r\n28:     encoded = set()\r\n29:     for variant in variants:\r\n30:         encoded.add(variant.encode(\"utf-8\"))\r\n31:         encoded.add(variant.encode(\"utf-16-le\"))\r\n32: \r\n33:     return list(encoded)\r\n34: \r\n35: \r\n36: def main() -> int:\r\n37:     parser = argparse.ArgumentParser()\r\n38:     parser.add_argument(\"chart\", type=Path)\r\n39:     parser.add_argument(\"extracted_dirs\", type=Path, nargs=\"+\")\r\n40:     parser.add_argument(\"--control\", nargs=\"+\", default=[\"uiProgressDataset\", \"PROG_RECORD\", \"CMovieSubtitleContainer\"])\r\n41:     args = parser.parse_args()\r\n42: \r\n43:     if not args.chart.is_file():\r\n44:         print(f\"Not a file: {args.chart}\", file=sys.stderr)\r\n45:         return 1\r\n46: \r\n47:     titles = collect_titles(args.chart)\r\n48:     needles = {title: encodings(title) for title in titles}\r\n49:     controls = {text: encodings(text) for text in args.control}\r\n50:     hits = defaultdict(set)\r\n51:     control_hits = defaultdict(int)\r\n52:     scanned = 0\r\n53:     for directory in args.extracted_dirs:\r\n54:         if not directory.is_dir():\r\n55:             print(f\"Not a directory: {directory}\", file=sys.stderr)\r\n56:             return 1\r\n57: \r\n58:         for path in sorted(directory.glob(\"*.bin\")):\r\n59:             data = path.read_bytes()\r\n60:             scanned += len(data)\r\n61:             for title, variants in needles.items():\r\n62:                 if any(variant in data for variant in variants):\r\n63:                     hits[title].add(path.name)\r\n64: \r\n65:             for text, variants in controls.items():\r\n66:                 if any(variant in data for variant in variants):\r\n67:                     control_hits[text] += 1\r\n68: \r\n69:     print(f\"candidate titles={len(titles)} scanned_bytes={scanned}\")\r\n70:     print(f\"titles found in readable data: {len(hits)}\")\r\n71:     for title, files in sorted(hits.items()):\r\n72:         print(f\"   {title!r}: {sorted(files)[:3]}\")\r\n73: \r\n74:     print(f\"control strings found (files): {dict(control_hits)}\")\r\n75:     return 0\r\n76: \r\n77: \r\n78: if __name__ == \"__main__\":\r\n79:     sys.exit(main())\r\n80: \nThe above content shows the entire, complete file contents of the requested file.\n"}
