t\", \"mailbox\", \"cash\"\n33:     rect = patches.Rectangle(\n34:         (x, y), w, h,\n35:         linewidth=1.0,\n36:         edgecolor=\"#71717a\",\n37:         facecolor=\"#ffffff\",\n38:         zorder=3\n39:     )\n40:     ax.add_patch(rect)\n41:     \n42:     icon_str = \"\"\n43:     if icon_type == \"phone\":\n44:         icon_str = \"[☎ CALL] \"\n45:     elif icon_type == \"text\":\n46:         icon_str = \"[✉ MSG] \"\n47:     elif icon_type == \"mailbox\":\n48:         icon_str = \"[📭 MAIL] \"\n49:     elif icon_type == \"cash\":\n50:         icon_str = \"[💰 CASH] \"\n51:         \n52:     full_text = icon_str + text\n53:     ax.text(x + w/2, y + h/2, full_text, ha=\"center\", va=\"center\", fontsize=7.2, fontweight=\"bold\" if icon_type==\"phone\" else \"normal\", color=\"#09090b\", zorder=4)\n54: \n55: def draw_heart(ax, x, y, w, h, text, skip_tag=True):\n56:     # Relationship / Domestic Task\n57:     rect = patches.Rectangle(\n58:         (x, y), w, h,\n59:         linewidth=1.2,\n60:         edgecolor=\"#f43f5e\",\n61:         facecolor=\"#ffe4e6\",\n62:         zorder=3\n63:     )\n64:     ax.add_patch(rect)\n65:     heart_text = \"♥ \" + text\n66:     if skip_tag:\n67:         heart_text += \"\\n[ANY% SKIP]\"\n68:     ax.text(x + w/2, y + h/2, heart_text, ha=\"center\", va=\"center\", fontsize=6.8, fontweight=\"bold\", color=\"#9f1239\", zorder=4)\n69: \n70: def draw_side(ax, x, y, w, h, text, skip_tag=True):\n71:     # Purple side activity\n72:     rect = patches.Rectangle(\n73:         (x, y), w, h,\n74:         linewidth=1.2,\n75:         edgecolor=\"#a855f7\",\n76:         facecolor=\"#f3e8ff\",\n77:         zorder=3\n78:     )\n79:     ax.add_patch(rect)\n80:     side_text = text\n81:     if skip_tag:\n82:         side_text += \"\\n[OPTIONAL / SKIP]\"\n83:     ax.text(x + w/2, y + h/2, side_text, ha=\"center\", va=\"center\", fontsize=6.8, color=\"#581c87\", zorder=4)\n84: \n85: def draw_diamond(ax, cx, cy, r, text):\n86:     pts = [[cx, cy +