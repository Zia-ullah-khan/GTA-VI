{"step_index":395,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-24T23:52:57Z","content":"Created At: 2026-11-24T18:52:57-05:00\nCompleted At: 2026-11-24T18:52:58-05:00\nFile Path: `file:///C:/Users/<user>/.gemini/antigravity-cli/brain/96252013-4633-45e8-b6a2-59b18be9e68c/scratch/build_all_flowcharts.py`\nTotal Lines: 835\nTotal Bytes: 42300\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import matplotlib.pyplot as plt\n2: import matplotlib.patches as patches\n3: import os\n4: import shutil\n5: \n6: WORKSPACE_DIR = r\"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK\"\n7: DOWNLOADS_DIR = r\"C:\\Users\\<user>\\Downloads\"\n8: ARTIFACT_DIR = r\"C:\\Users\\<user>\\.gemini\\antigravity-cli\\brain\\96252013-4633-45e8-b6a2-59b18be9e68c\"\n9: \n10: BG_COLOR = \"#0c1017\"\n11: TEXT_COLOR = \"#f8fafc\"\n12: SUBTEXT_COLOR = \"#94a3b8\"\n13: \n14: STYLES = {\n15:     \"normal\": {\n16:         \"bg\": \"#161d2b\",\n17:         \"border\": \"#00d4ff\",\n18:         \"title\": \"#38bdf8\",\n19:         \"badge_bg\": \"#083344\",\n20:         \"badge_fg\": \"#38bdf8\"\n21:     },\n22:     \"milestone\": {\n23:         \"bg\": \"#231528\",\n24:         \"border\": \"#ff007f\",\n25:         \"title\": \"#fb7185\",\n26:         \"badge_bg\": \"#4c0519\",\n27:         \"badge_fg\": \"#ff007f\"\n28:     },\n29:     \"heist\": {\n30:         \"bg\": \"#281e10\",\n31:         \"border\": \"#f59e0b\",\n32:         \"title\": \"#fde047\",\n33:         \"badge_bg\": \"#451a03\",\n34:         \"badge_fg\": \"#fbbf24\"\n35:     },\n36:     \"point_of_no_return\": {\n37:         \"bg\": \"#300e18\",\n38:         \"border\": \"#ef4444\",\n39:         \"title\": \"#fca5a5\",\n40:         \"badge_bg\": \"#7f1d1d\",\n41:         \"badge_fg\": \"#fca5a5\"\n42:     },\n43:     \"ending\": {\n44:         \"bg\": \"#0c2820\",\n45:         \"border\": \"#10b981\",\n46:         \"title\": \"#34d399\",\n47:         \"badge_bg\": \"#064e3b\",\n48:         \"badge_fg\": \"#34d399\"\n49:     }\n50: }\n51: \n52: def draw_card(ax, x, y, w, h, title, subtitle=\"\", badge=\"\", card_type=\"normal\", fontsize=9):\n53:     st = STYLES.get(card_type, STYLES[\"normal\"])\n54:     \n55:     rect = patches.FancyBboxPatch(\n56:         (x, y), w, h,\n57:         boxstyle=\"round,pad=0.03,rounding_size=0.15\",\n58:         linewidth=1.6,\n59:         edgecolor=st[\"border\"],\n60:         facecolor=st[\"bg\"],\n61:         zorder=3\n62:     )\n63:     ax.add_patch(rect)\n64:     \n65:     if badge:\n66:         ax.text(\n67:             x + w/2, y + h - 0.16,\n68:             badge.upper(),\n69:             ha=\"center\", va=\"center\",\n70:             fontsize=fontsize - 2.5,\n71:             fontweight=\"bold\",\n72:             color=st[\"badge_fg\"],\n73:             bbox=dict(boxstyle=\"round,pad=0.22\", facecolor=st[\"badge_bg\"], edgecolor=st[\"border\"], lw=0.8),\n74:             zorder=4\n75:         )\n76:         title_y = y + h/2 + 0.04\n77:         sub_y = y + 0.22\n78:     else:\n79:         title_y = y + h/2 + 0.14 if subtitle else y + h/2\n80:         sub_y = y + h/2 - 0.20\n81: \n82:     ax.text(\n83:         x + w/2, title_y,\n84:         title,\n85:         ha=\"center\", va=\"center\",\n86:         fontsize=fontsize,\n87:         fontweight=\"bold\",\n88:         color=st[\"title\"],\n89:         zorder=4\n90:     )\n91:     \n92:     if subtitle:\n93:         ax.text(\n94:             x + w/2, sub_y,\n95:             subtitle,\n96:             ha=\"center\", va=\"center\",\n97:             fontsize=fontsize - 2.2,\n98:             color=SUBTEXT_COLOR,\n99:             zorder=4\n100:         )\n101: \n102: def draw_diamond(ax, cx, cy, rx, ry, text, fontsize=7.2):\n103:     pts = [[cx, cy + ry], [cx + rx, cy], [cx, cy - ry], [cx - rx, cy]]\n104:     poly = patches.Polygon(pts, closed=True, linewidth=1.5, edgecolor=\"#f59e0b\", facecolor=\"#281e10\", zorder=3)\n105:     ax.add_patch(poly)\n106:     ax.text(cx, cy, text, ha=\"center\", va=\"center\", fontsize=fontsize, fontweight=\"bold\", color=\"#fde047\", zorder=4)\n107: \n108: def draw_arrow(ax, p1, p2, color=\"#38bdf8\", lw=1.6, rad=0.0):\n109:     conn = f\"arc3,rad={rad}\" if rad != 0 else \"arc3,rad=0\"\n110:     ax.annotate(\n111:         \"\",\n112:         xy=p2, xytext=p1,\n113:         arrowprops=dict(\n114:             arrowstyle=\"->,head_width=0.32,head_length=0.42\",\n115:             color=color,\n116:             lw=lw,\n117:             shrinkA=4,\n118:             shrinkB=4,\n119:             connectionstyle=conn\n120:         ),\n121:         zorder=2\n122:     )\n123: \n124: def setup_header(ax, title, subtitle, w_total, y_top=11.5):\n125:     ax.text(\n126:         w_total / 2, y_top,\n127:         title,\n128:         ha=\"center\", va=\"center\",\n129:         fontsize=16,\n130:         fontweight=\"bold\",\n131:         color=\"#ffffff\",\n132:         zorder=5\n133:     )\n134:     ax.text(\n135:         w_total / 2, y_top - 0.45,\n136:         subtitle,\n137:         ha=\"center\", va=\"center\",\n138:         fontsize=10.5,\n139:         color=\"#38bdf8\",\n140:         zorder=5\n141:     )\n142: \n143: def copy_to_all(src_filename):\n144:     art_path = os.path.join(ARTIFACT_DIR, src_filename)\n145:     ws_path = os.path.join(WORKSPACE_DIR, src_filename)\n146:     dl_path = os.path.join(DOWNLOADS_DIR, src_filename)\n147:     if os.path.exists(art_path):\n148:         shutil.copyfile(art_path, ws_path)\n149:         shutil.copyfile(art_path, dl_path)\n150:         print(f\"Synced {src_filename} to workspace and Downloads.\")\n151: \n152: # =========================================================================\n153: # 1. CHAPTER 1: TRUE PARALLEL BRANCHING (MATCHING image_1188e9.jpg GROUND TRUTH)\n154: # =========================================================================\n155: def render_chapter_1():\n156:     fig, ax = plt.subplots(figsize=(24, 18), dpi=200)\n157:     fig.patch.set_facecolor(BG_COLOR)\n158:     ax.set_facecolor(BG_COLOR)\n159:     ax.set_xlim(0, 24)\n160:     ax.set_ylim(0, 18)\n161:     ax.axis(\"off\")\n162:     \n163:     setup_header(\n164:         ax,\n165:         \"GRAND THEFT AUTO VI — CHAPTER 1: JUST LIKE PARADISE\",\n166:         \"Setting: Leonida Keys (Key Lento & Southwind Marina) | Missions 1 - 18 (Ends at Doin' Gone) | 3 Parallel Branches & Gates\",\n167:         24,\n168:         y_top=17.4\n169:     )\n170:     \n171:     w, h = 3.6, 1.05\n172:     center_x = 10.2\n173:     \n174:     # Top: 1. Prologue -> 2. Gone Fishing\n175:     draw_card(ax, center_x, 15.6, w, h, \"1. Prologue\", \"Lucia Prison Counselor Interview\", \"Intro\", \"normal\")\n176:     draw_card(ax, center_x, 14.1, w, h, \"2. Gone Fishing\", \"Jason & Donnie Boat Drop ($140 Mailbox)\", \"\", \"normal\")\n177:     draw_arrow(ax, (center_x + w/2, 15.6), (center_x + w/2, 15.15))\n178:     \n179:     # 3-Track Horizontal Split Bar\n180:     split_y = 13.3\n181:     ax.plot([2.5, 6.2, 12.0], [split_y, split_y, split_y], color=\"#38bdf8\", lw=1.8, zorder=2)\n182:     draw_arrow(ax, (center_x + w/2, 14.1), (center_x + w/2, split_y))\n183:     \n184:     # -------------------------------------------------------------\n185:     # BRANCH 1: UNWANTED ATTENTION & PIPEWORK (Left Track: x = 0.8)\n186:     # -------------------------------------------------------------\n187:     b1_x = 0.8\n188:     draw_arrow(ax, (2.5, split_y), (b1_x + w/2, 12.35))\n189:     draw_card(ax, b1_x, 11.3, w, h, \"6. Unwanted Attention\", \"Cal Trip to Hamlet ($200 Mailbox)\", \"Branch 1\", \"normal\")\n190:     draw_card(ax, b1_x, 9.7, w, h, \"7. Pipework\", \"Marina Maintenance Jobs\", \"Branch 1\", \"normal\")\n191:     draw_arrow(ax, (b1_x + w/2, 11.3), (b1_x + w/2, 10.75))\n192:     \n193:     # Downtime tip box\n194:     p1 = patches.FancyBboxPatch((b1_x, 7.8), w, 1.4, boxstyle=\"round,pad=0.03,rounding_size=0.15\", linewidth=1.2, edgecolor=\"#10b981\", facecolor=\"#064e3b\", zorder=3)\n195:     ax.add_patch(p1)\n196:     ax.text(b1_x + w/2, 8.8, \"⚡ PARALLEL DOWNTIME ROUTE\", ha=\"center\", va=\"center\", fontsize=7.8, fontweight=\"bold\", color=\"#34d399\", zorder=4)\n197:     ax.text(b1_x + w/2, 8.2, \"Clear Missions 6 & 7 during Feng Shui's\\n24-hour waiting window for optimal routing.\", ha=\"center\", va=\"center\", fontsize=6.8, color=\"#ecfdf5\", zorder=4)\n198:     draw_arrow(ax, (b1_x + w/2, 9.7), (b1_x + w/2, 9.2))\n199:     \n200:     # -------------------------------------------------------------\n201:     # BRANCH 2: GEAR UP & JUST A SCRATCH (Middle Track: x = 4.8)\n202:     # -------------------------------------------------------------\n203:     b2_x = 4.8\n204:     draw_arrow(ax, (6.2, split_y), (b2_x + w/2, 12.35))\n205:     draw_card(ax, b2_x, 11.3, w, h, \"3. Gear Up\", \"Pick up Longarm for Brian\", \"Branch 2\", \"normal\")\n206:     draw_card(ax, b2_x, 9.7, w, h, \"4. Just a Scratch\", \"Ganado Repair & Respray\", \"MANDATORY GATE\", \"milestone\")\n207:     draw_arrow(ax, (b2_x + w/2, 11.3), (b2_x + w/2, 10.75))\n208:     \n209:     # Scratch line runs down to Diamond 2\n210:     scratch_line_x = b2_x + w/2\n211:     \n212:     # -------------------------------------------------------------\n213:     # SUB-BRANCH: ISLAND DREAMS (Keys Diving: x = 8.6)\n214:     # -------------------------------------------------------------\n215:     isl_x = 8.6\n216:     draw_card(ax, isl_x - 3.4, 8.2, 3.0, h, \"9. Island Dreams\", \"Keys Diving (Kenton Treasure)\", \"Side Activity\", \"normal\", fontsize=8.2)\n217:     \n218:     # -------------------------------------------------------------\n219:     # BRANCH 3: LAB FEES -> HEY ARNOLD! -> FENG SHUI -> COMING HOME (x = 10.2)\n220:     # -------------------------------------------------------------\n221:     b3_x = 10.2\n222:     draw_arrow(ax, (12.0, split_y), (b3_x + w/2, 12.35))\n223:     draw_card(ax, b3_x, 11.3, w, h, \"5. Lab Fees\", \"Brian's Rent Collection\", \"Branch 3\", \"normal\")\n224:     draw_card(ax, b3_x, 9.7, w, h, \"8. Hey Arnold!\", \"Track Down Cargo Broker\", \"Branch 3\", \"normal\")\n225:     draw_arrow(ax, (b3_x + w/2, 11.3), (b3_x + w/2, 10.75))\n226:     \n227:     # Offshoot arrow to Island Dreams\n228:     draw_arrow(ax, (b3_x, 10.2), (isl_x - 0.4, 8.7), rad=0.15)\n229:     \n230:     # FENG SHUI\n231:     draw_card(ax, b3_x, 8.1, w, h, \"10. Feng Shui\", \"Move Furniture for Brian (24h Wait)\", \"\", \"normal\")\n232:     draw_arrow(ax, (b3_x + w/2, 9.7), (b3_x + w/2, 9.15))\n233:     \n234:     # COMING HOME\n235:     draw_card(ax, b3_x, 6.5, w, h, \"11. Coming Home\", \"Lucia Released from Prison\", \"LUCIA REUNION\", \"milestone\")\n236:     draw_arrow(ax, (b3_x + w/2, 8.1), (b3_x + w/2, 7.55))\n237:     \n238:     # FIND DONNIE'S PACKAGE (RESTORED GROUND TRUTH!)\n239:     draw_card(ax, b3_x, 4.9, w, h, \"12. Find Donnie's Package\", \"Retrieve Hamlet Drop Package\", \"\", \"normal\")\n240:     draw_arrow(ax, (b3_x + w/2, 6.5), (b3_x + w/2, 5.95))\n241:     \n242:     # DECISION DIAMOND 1: Did player finish Just a Scratch?\n243:     dia1_y = 3.6\n244:     draw_diamond(ax, b3_x + w/2, dia1_y, 2.2, 0.65, \"Did player finish\\nJUST A SCRATCH?\")\n245:     draw_arrow(ax, (b3_x + w/2, 4.9), (b3_x + w/2, dia1_y + 0.65))\n246:     \n247:     # Diamond 1 No Branch (Joey Reminder Call -> Points back to Just a Scratch)\n248:     p_joey = patches.FancyBboxPatch((b3_x - 4.2, dia1_y - 0.45), 3.4, 0.9, boxstyle=\"round,pad=0.03,rounding_size=0.15\", linewidth=1.0, edgecolor=\"#f43f5e\", facecolor=\"#300e18\", zorder=3)\n249:     ax.add_patch(p_joey)\n250:     ax.text(b3_x - 2.5, dia1_y, \"NO: Joey Reminder Call\\n(Redirects to Just a Scratch)\", ha=\"center\", va=\"center\", fontsize=7.2, color=\"#fca5a5\", zorder=4)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
