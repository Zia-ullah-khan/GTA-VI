"64. The Missing Link\", \"Interrogate Monty for Vault Codes\", \"Insider Intel\", \"heist\", fontsize=8.5)\n    draw_card(ax, 16.9, 4.5, 4.2, 1.1, \"67. Ride or Die\", \"Acquire Armored Extraction Van\", \"Getaway Vehicle\", \"heist\", fontsize=8.5)\n    draw_arrow(ax, (16.5, 5.05), (16.9, 5.05), color=\"#fde047\")\n    \n    draw_arrow(ax, (s1_x2 + w, heist_scope_y + 0.65), (t1_x, 10.15), color=\"#fbbf24\", rad=-0.15)\n    draw_arrow(ax, (s1_x2 + w, heist_scope_y + 0.65), (t2_x, 10.15), color=\"#fbbf24\", rad=-0.25)\n    draw_arrow(ax, (s1_x2 + w, heist_scope_y + 0.65), (12.3, 5.05), color=\"#fbbf24\", rad=0.15)\n    \n    heist_fin_y = 1.8\n    draw_card(ax, 13.5, heist_fin_y, 6.4, 1.35, \"70. THE CARTEL HEIST\", \"Sinfrontera National Bank Vault Raid ($10.5M Take)\\n★ Keep $75,000 for Chapter 4 Abe Gate! ★\", \"MAJOR HEIST CLIMAX\", \"point_of_no_return\", fontsize=9.5)\n    \n    draw_arrow(ax, (t1_x + 2.1, 6.2), (14.5, heist_fin_y + 1.35), color=\"#ef4444\")\n    draw_arrow(ax, (t2_x + 2.1, 6.2), (18.5, heist_fin_y + 1.35), color=\"#ef4444\")\n    draw_arrow(ax, (19.0, 4.5), (17.5, heist_fin_y + 1.35), color=\"#ef4444\")\n    \n    draw_card(ax, 7.8, 1.8, w, 1.0, \"→ TRANSITION TO CH. 4\", \"Destination: Ocean Beach (VC)\", \"\", \"point_of_no_return\")\n    draw_arrow(ax, (13.5, heist_fin_y + 0.65), (7.8 + w, 2.3), color=\"#ef4444\")\n    \n    out_path = os.path.join(WORKSPACE_DIR, \"flowchart_chapter_3.png\")\n    plt.savefig(out_path, bbox_inches=\"tight\", facecolor=BG_COLOR)\n    plt.close()\n    print(\"Saved:\", out_path)","StartLine":300,"TargetContent":"        ax,\n        \"GRAND THEFT AUTO VI — CHAPTER 3: TITS, ASS, DRUG MONEY\",\n        \"Setting: Vice City Outskirts & Cartel Hubs | Missions 45 - 70 | Sinfrontera Bank Heist Prep Tree\",\n        20,\n        y_top=12.4\n    )\n    \n    w, h = 3.4, 1.12\n    gap = 1.35\n    \n    col1 = [\n        (\"45. Welcome to Vice City\", \"Arrival in the Metropolis\", \"\", \"normal\"),\n        (\"46. De