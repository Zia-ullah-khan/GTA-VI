\r\n32: \r\n33: def find_variants(base_id: str, table: dict[str, dict], listed: set[str]) -> list[str]:\r\n34:     prefix = base_id.upper() + \"_\"\r\n35:     return sorted(entry[\"id\"] for key, entry in table.items() if key.startswith(prefix) and key not in listed)\r\n36: \r\n37: \r\n38: def canonical_id(raw_id: str, table: dict[str, dict]) -> str:\r\n39:     entry = table.get(raw_id.upper())\r\n40:     return entry[\"id\"] if entry else raw_id.upper()\r\n41: \r\n42: \r\n43: def label_mission_id(label: str, table: dict[str, dict]) -> str | None:\r\n44:     candidate = label.upper()\r\n45:     if candidate.startswith(LABEL_PREFIX):\r\n46:         candidate = candidate[len(LABEL_PREFIX):]\r\n47: \r\n48:     return table[candidate][\"id\"] if candidate in table else None\r\n49: \r\n50: \r\n51: def build_listed_missions(listing: list[dict], table: dict[str, dict]) -> list[dict]:\r\n52:     listed_keys = set()\r\n53:     for category in listing:\r\n54:         for group in category[\"filters\"]:\r\n55:             listed_keys.update(item[\"item_id\"].upper() for item in group[\"items\"])\r\n56: \r\n57:     missions = []\r\n58:     for category in listing:\r\n59:         for group in category[\"filters\"]:\r\n60:             chapter = CHAPTER_NUMBERS[group[\"filter_id\"]]\r\n61:             for item in group[\"items\"]:\r\n62:                 entry = table.get(item[\"item_id\"].upper())\r\n63:                 mission_id = canonical_id(item[\"item_id\"], table)\r\n64:                 unlock_id = canonical_id(item[\"unlock_id\"], table)\r\n65:                 labelled_as = label_mission_id(item[\"label\"], table)\r\n66:                 evidence = [f\"{PROGRESS_SOURCE} \"\r\n67:                             + PROGRESS_PATH.format(filter_id=group[\"filter_id\"], position=item[\"position\"])]\r\n68:                 if entry:\r\n69:                     evidence.append(f\"{CMISSIONS_SOURCE} Item[UniqueMissionIndex={entry['index']}]\")\r\n70: \r\n71:                 missions.app