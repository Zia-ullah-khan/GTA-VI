{"step_index":933,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-25T02:59:04Z","content":"Created At: 2026-11-24T21:59:04-05:00\nCompleted At: 2026-11-24T21:59:04-05:00\nFile Path: `file:///C:/Users/<user>/.gemini/antigravity-cli/brain/96252013-4633-45e8-b6a2-59b18be9e68c/scratch/render_classic_design_flowcharts.py`\nTotal Lines: 1024\nTotal Bytes: 50157\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import matplotlib.pyplot as plt\n2: import matplotlib.patches as patches\n3: import os\n4: import shutil\n5: \n6: # Directories\n7: WORKSPACE_DIR = r\"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK\"\n8: DOWNLOADS_DIR = r\"C:\\Users\\<user>\\Downloads\"\n9: ANTIGRAV_DL_DIR = r\"C:\\Users\\<user>\\Downloads\\antigravity_version\"\n10: ANTIGRAV_WS_DIR = r\"C:\\Users\\<user>\\Downloads\\GTA6.Xbox.v1.0.2.1-CYBERLEEK\\output\\antigravity_version\"\n11: ARTIFACT_DIR = r\"C:\\Users\\<user>\\.gemini\\antigravity-cli\\brain\\96252013-4633-45e8-b6a2-59b18be9e68c\"\n12: \n13: # Classic Ground-Truth Theme Colors (Matching image_1188e9.jpg & GTAVI_SPEEDRUN_CHAPTER1_COMPLETE.jpg)\n14: BG_COLOR = \"#33363b\"          # Slate-gray background\n15: CARD_BG_NORMAL = \"#fef08a\"    # Warm cream / yellow\n16: CARD_BORDER_NORMAL = \"#ca8a04\"# Golden yellow border\n17: CARD_BG_CLIMAX = \"#ffedd5\"    # Warm peach / orange\n18: CARD_BORDER_CLIMAX = \"#ea580c\"# Deep orange border\n19: TEXT_COLOR = \"#1c1917\"        # Dark charcoal / black text\n20: SUBTEXT_COLOR = \"#44403c\"     # Muted charcoal subtext\n21: \n22: def draw_mission(ax, x, y, w, h, title, subtitle=\"\", is_climax=False, is_gate=False, font_size=8.5):\n23:     bg = CARD_BG_CLIMAX if is_climax else CARD_BG_NORMAL\n24:     border = CARD_BORDER_CLIMAX if is_climax else CARD_BORDER_NORMAL\n25:     lw = 2.0 if (is_climax or is_gate) else 1.2\n26:     \n27:     rect = patches.FancyBboxPatch(\n28:         (x, y), w, h,\n29:         boxstyle=\"round,pad=0.02,rounding_size=0.10\",\n30:         linewidth=lw,\n31:         edgecolor=border,\n32:         facecolor=bg,\n33:         zorder=3\n34:     )\n35:     ax.add_patch(rect)\n36:     \n37:     ty = y + h/2 + 0.13 if subtitle else y + h/2\n38:     ax.text(x + w/2, ty, title, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=TEXT_COLOR, zorder=4)\n39:     if subtitle:\n40:         ax.text(x + w/2, y + 0.20, subtitle, ha=\"center\", va=\"center\", fontsize=font_size-1.8, color=SUBTEXT_COLOR, zorder=4)\n41: \n42: def draw_callout(ax, x, y, w, h, text, icon_type=\"text\", font_size=7.2):\n43:     rect = patches.FancyBboxPatch(\n44:         (x, y), w, h,\n45:         boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n46:         linewidth=1.0,\n47:         edgecolor=\"#71717a\",\n48:         facecolor=\"#ffffff\",\n49:         zorder=3\n50:     )\n51:     ax.add_patch(rect)\n52:     \n53:     prefix = \"\"\n54:     if icon_type == \"phone\":\n55:         prefix = \"[CALL] \"\n56:     elif icon_type == \"text\":\n57:         prefix = \"[MSG] \"\n58:     elif icon_type == \"mailbox\":\n59:         prefix = \"[MAILBOX] \"\n60:     elif icon_type == \"cash\":\n61:         prefix = \"[$] \"\n62:         \n63:     ax.text(x + w/2, y + h/2, prefix + text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\" if icon_type in [\"phone\", \"cash\"] else \"normal\", color=\"#09090b\", zorder=4)\n64: \n65: def draw_heart(ax, x, y, w, h, text, skip_label=\"[ANY% SKIP]\", font_size=7.0):\n66:     rect = patches.FancyBboxPatch(\n67:         (x, y), w, h,\n68:         boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n69:         linewidth=1.2,\n70:         edgecolor=\"#f43f5e\",\n71:         facecolor=\"#ffe4e6\",\n72:         zorder=3\n73:     )\n74:     ax.add_patch(rect)\n75:     t = \"♥ \" + text\n76:     if skip_label:\n77:         t += \"\\n\" + skip_label\n78:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#9f1239\", zorder=4)\n79: \n80: def draw_side(ax, x, y, w, h, text, font_size=7.0):\n81:     rect = patches.FancyBboxPatch(\n82:         (x, y), w, h,\n83:         boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n84:         linewidth=1.2,\n85:         edgecolor=\"#a855f7\",\n86:         facecolor=\"#f3e8ff\",\n87:         zorder=3\n88:     )\n89:     ax.add_patch(rect)\n90:     t = text + \"\\n[OPTIONAL / SKIP]\"\n91:     ax.text(x + w/2, y + h/2, t, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#581c87\", zorder=4)\n92: \n93: def draw_diamond(ax, cx, cy, rx, ry, text, font_size=6.8):\n94:     pts = [[cx, cy + ry], [cx + rx, cy], [cx, cy - ry], [cx - rx, cy]]\n95:     poly = patches.Polygon(pts, closed=True, linewidth=1.4, edgecolor=\"#cbd5e1\", facecolor=\"#ffffff\", zorder=3)\n96:     ax.add_patch(poly)\n97:     ax.text(cx, cy, text, ha=\"center\", va=\"center\", fontsize=font_size, fontweight=\"bold\", color=\"#0f172a\", zorder=4)\n98: \n99: def draw_speedrun_badge(ax, x, y, w, h, title, note, font_size=6.8):\n100:     rect = patches.FancyBboxPatch(\n101:         (x, y), w, h,\n102:         boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n103:         linewidth=1.4,\n104:         edgecolor=\"#10b981\",\n105:         facecolor=\"#064e3b\",\n106:         zorder=3\n107:     )\n108:     ax.add_patch(rect)\n109:     ax.text(x + w/2, y + h - 0.22, \"⚡ \" + title, ha=\"center\", va=\"center\", fontsize=font_size+0.6, fontweight=\"bold\", color=\"#34d399\", zorder=4)\n110:     ax.text(x + w/2, y + h/2 - 0.1, note, ha=\"center\", va=\"center\", fontsize=font_size, color=\"#ecfdf5\", zorder=4)\n111: \n112: def draw_arrow(ax, p1, p2, color=\"#ffffff\", lw=1.2, rad=0.0):\n113:     conn = f\"arc3,rad={rad}\" if rad != 0 else \"arc3,rad=0\"\n114:     ax.annotate(\n115:         \"\",\n116:         xy=p2, xytext=p1,\n117:         arrowprops=dict(\n118:             arrowstyle=\"->,head_width=0.28,head_length=0.38\",\n119:             color=color,\n120:             lw=lw,\n121:             shrinkA=3,\n122:             shrinkB=3,\n123:             connectionstyle=conn\n124:         ),\n125:         zorder=2\n126:     )\n127: \n128: def draw_stage_bridge(ax, x1, y1, x2, y2, gx, label):\n129:     ax.plot([x1, gx, gx, x2], [y1, y1, y2, y2], color=\"#ffffff\", lw=1.6, zorder=2)\n130:     draw_arrow(ax, (gx, y2), (x2, y2), color=\"#ffffff\", lw=1.6)\n131:     \n132:     badge = patches.FancyBboxPatch(\n133:         (gx - 0.9, (y1 + y2)/2 - 0.35), 1.8, 0.7,\n134:         boxstyle=\"round,pad=0.02,rounding_size=0.08\",\n135:         linewidth=1.0,\n136:         edgecolor=\"#cbd5e1\",\n137:         facecolor=\"#26292e\",\n138:         zorder=4\n139:     )\n140:     ax.add_patch(badge)\n141:     ax.text(gx, (y1 + y2)/2, label, ha=\"center\", va=\"center\", fontsize=6.5, fontweight=\"bold\", color=\"#fde047\", zorder=5)\n142: \n143: def copy_to_all(filename):\n144:     src = os.path.join(ARTIFACT_DIR, filename)\n145:     targets = [\n146:         os.path.join(WORKSPACE_DIR, filename),\n147:         os.path.join(DOWNLOADS_DIR, filename),\n148:         os.path.join(ANTIGRAV_DL_DIR, filename),\n149:         os.path.join(ANTIGRAV_WS_DIR, filename),\n150:     ]\n151:     for dst in targets:\n152:         os.makedirs(os.path.dirname(dst), exist_ok=True)\n153:         copied = False\n154:         for attempt in range(3):\n155:             try:\n156:                 shutil.copyfile(src, dst)\n157:                 copied = True\n158:                 break\n159:             except Exception as e:\n160:                 import time\n161:                 time.sleep(0.3)\n162:         if not copied:\n163:             try:\n164:                 with open(src, \"rb\") as fsrc:\n165:                     data = fsrc.read()\n166:                 tmp_dst = dst + \".new\"\n167:                 with open(tmp_dst, \"wb\") as ftmp:\n168:                     ftmp.write(data)\n169:                 os.replace(tmp_dst, dst)\n170:                 copied = True\n171:             except Exception as ex:\n172:                 print(f\"Warning: Could not copy {filename} to {dst}: {ex}\")\n173:     print(f\"Propagated {filename} to all locations.\")\n174: \n175: def setup_header(ax, title, subtitle, max_x, y_top):\n176:     ax.text(max_x / 2, y_top, title, ha=\"center\", va=\"center\", fontsize=16, fontweight=\"bold\", color=\"#ffffff\")\n177:     ax.text(max_x / 2, y_top - 0.5, subtitle, ha=\"center\", va=\"center\", fontsize=9.5, color=\"#fde047\")\n178: \n179: # =========================================================================\n180: # 1. CHAPTER 1: EXACT MATCH TO image_1188e9.jpg GROUND TRUTH\n181: # =========================================================================\n182: def render_chapter_1():\n183:     fig, ax = plt.subplots(figsize=(25, 28), dpi=200)\n184:     fig.patch.set_facecolor(BG_COLOR)\n185:     ax.set_facecolor(BG_COLOR)\n186:     ax.set_xlim(0, 25)\n187:     ax.set_ylim(0, 28)\n188:     ax.axis(\"off\")\n189:     \n190:     setup_header(\n191:         ax,\n192:         \"GRAND THEFT AUTO VI — CHAPTER 1: LEONIDA KEYS MISSION FLOW\",\n193:         \"Ground Truth 3-Track Parallel Layout, Decision Diamonds, Mailboxes & Corrected Flow (Missions 1 - 18)\",\n194:         25,\n195:         y_top=27.4\n196:     )\n197:     \n198:     mw, mh = 3.6, 0.95\n199:     center_x = 10.8\n200:     \n201:     draw_mission(ax, center_x, 25.5, mw, mh, \"1. PROLOGUE\", \"Lucia Prison Counselor Interview\")\n202:     draw_mission(ax, center_x, 24.0, mw, mh, \"2. GONE FISHING\", \"Jason & Donnie Boat Drop\")\n203:     draw_arrow(ax, (center_x + mw/2, 25.5), (center_x + mw/2, 24.95))\n204:     \n205:     # Donnie Text Mailbox\n206:     draw_callout(ax, center_x + mw + 0.4, 24.05, 3.4, 0.75, \"DONNIE TEXT\\n($140 IN MAILBOX)